@page "/not-found"
@layout MainLayout

<PageTitle>Page not found | Mulse</PageTitle>

<div class="page-shell">
    <header class="page-hero">
        <div>
            <p class="eyebrow">404 / Page not found</p>
            <h1>This page isn't here</h1>
