@page "/designer"
@page "/designer/{FlowId}"
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IMulseApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(IsExistingFlow ? $"Edit flow {FlowId}" : "Flow designer")</PageTitle>

<div class="page-shell">
    <header class="page-hero">
        <div>
            <p class="eyebrow">Visual flow canvas</p>
            <h1>@(IsExistingFlow ? FlowId : "New flow")</h1>
            <p class="lede">
                One canvas for every flow: drop modules in by hand, seed the graph from a sample payload, import a BizTalk draft flow,
                or open an existing flow and rewire it. Drag nodes to arrange the graph and click a node to configure its module and settings.
            </p>
            <a class="secondary-button" href="/">&larr; Back to dashboard</a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="status-banner success">@_statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="status-banner error">@_errorMessage</div>
    }

    <section class="toolbar">
        <div class="toolbar-group">
            <span class="toolbar-label">Add node</span>
            <button class="secondary-button" @onclick="AddSourceLane" title="Adds a new source lane: its own fetch node plus parse node, with a source id other sources and join augments can reference.">Source</button>
            <button class="secondary-button" @onclick="AddAugmentNode">Augment</button>
            <button class="secondary-button" @onclick="AddJoinAugmentNode" disabled="@(_sources.Count < 2)" title="Adds a multi-source join and map augment, pre-wired to the first two source lanes on the canvas.">Join sources</button>
            <button class="secondary-button" @onclick="AddDeliveryRoute">Delivery route</button>
        </div>
        <div class="toolbar-group">
            <span class="toolbar-label">Seed from</span>
            <button class="secondary-button @(_showSamplePanel ? "active" : null)" @onclick="ToggleSamplePanel">Import sample data</button>
            <button class="secondary-button @(_showBizTalkPanel ? "active" : null)" @onclick="ToggleBizTalkPanel">Import from BizTalk</button>
        </div>
        <div class="toolbar-group toolbar-actions">
            <button class="secondary-button" @onclick="AutoLayout">Auto layout</button>
            <button class="secondary-button" @onclick="ClearCanvas">Clear canvas</button>
            <button class="run-button" @onclick="SaveAsync" disabled="@_isSaving">@(_isSaving ? "Saving..." : IsExistingFlow ? "Save flow" : "Create flow")</button>
        </div>
    </section>

    @if (_showSamplePanel)
    {
        <article class="panel">
            <div class="panel-header">
                <div>
                    <h2>Import sample data</h2>
                    <p>Upload or paste a representative payload. Mulse detects the format, suggests modules, and seeds the canvas with them.</p>
                </div>
                <button class="secondary-button" @onclick="ToggleSamplePanel">Close</button>
            </div>

            <label class="drop-zone">
                <span>Select or drag a file here</span>
                <InputFile OnChange="HandleFileSelectedAsync" class="drop-zone-input" />
            </label>

            <div class="file-meta">
                <span><strong>Selected file:</strong> @(_fileName ?? "None")</span>
                <span><strong>Detected content type:</strong> @(_contentType ?? "Unknown")</span>
            </div>

            <label class="field-label" for="sample-text">Paste sample payload</label>
            <textarea id="sample-text" class="sample-textarea" @bind="_sampleText" @bind:event="oninput" placeholder="Paste JSON, XML, CSV, or raw text here."></textarea>

            <div class="action-row">
                <button class="run-button" @onclick="AnalyzeSampleAsync" disabled="@_isAnalyzingSample">@(_isAnalyzingSample ? "Analyzing..." : "Analyze sample")</button>
                <button class="secondary-button" @onclick="ClearSample" disabled="@_isAnalyzingSample">Clear sample</button>
            </div>

            @if (_analysis is not null)
            {
                <h3>Detected format: @_analysis.DetectedFormat</h3>
                <div class="preview-box">
                    <pre>@_analysis.Preview</pre>
                </div>

                <div class="suggestion-grid">
                    <section>
                        <h4>Fetch suggestions</h4>
                        <ul class="suggestion-list">
                            @foreach (var module in _analysis.FetchModules)
                            {
                                <li>@module.DisplayName <code>@module.Id</code>@(module.IsRecommended ? " - recommended" : string.Empty)</li>
                            }
                        </ul>
                    </section>
                    <section>
                        <h4>Parse suggestions</h4>
                        <ul class="suggestion-list">
                            @foreach (var module in _analysis.ParseModules)
                            {
                                <li>@module.DisplayName <code>@module.Id</code>@(module.IsRecommended ? " - recommended" : string.Empty)</li>
                            }
                        </ul>
                    </section>
                    <section>
                        <h4>Augment suggestions</h4>
                        <ul class="suggestion-list">
                            @foreach (var module in _analysis.OrchestrationAugmentModules)
                            {
                                <li>@module.DisplayName <code>@module.Id</code>@(module.IsRecommended ? " - recommended" : string.Empty)</li>
                            }
                        </ul>
                    </section>
                    <section>
                        <h4>Delivery suggestions</h4>
                        <ul class="suggestion-list">
                            @foreach (var module in _analysis.RenderModules)
                            {
                                <li>Render: @module.DisplayName <code>@module.Id</code></li>
                            }
                            @foreach (var module in _analysis.DeliverModules)
                            {
                                <li>Deliver: @module.DisplayName <code>@module.Id</code></li>
                            }
                        </ul>
                    </section>
                </div>

                <p class="field-hint">@_analysis.Fields.Count field mapping(s) were detected and will be attached to the flow when it is created.</p>

                <div class="action-row">
                    <button class="run-button" @onclick="ApplySampleAnalysis">Populate canvas from sample</button>
                </div>
            }
        </article>
    }

    @if (_showBizTalkPanel)
    {
        <article class="panel">
            <div class="panel-header">
                <div>
                    <h2>Import from BizTalk</h2>
                    <p>Point Mulse at a BizTalk solution, project, or directory, then load one generated draft flow onto the canvas and hand-edit it.</p>
                </div>
                <button class="secondary-button" @onclick="ToggleBizTalkPanel">Close</button>
            </div>

            <label class="field-label" for="source-path">Source path</label>
            <input id="source-path" class="mapping-input" @bind="_sourcePath" @bind:event="oninput" placeholder="C:\Users\...\MyBizTalkApp.sln" />

            <label class="field-label" for="additional-source-paths">Additional solutions/projects (optional)</label>
            <input id="additional-source-paths" class="mapping-input" @bind="_additionalSourcePaths" @bind:event="oninput" placeholder="C:\...\Partners.sln; C:\...\Core.sln" />
            <p class="field-hint">Semicolon-separated additional solution, project, or directory paths analyzed alongside the source path as one combined workspace.</p>

            <label class="field-label" for="additional-binding-paths">Additional binding export paths (optional)</label>
            <input id="additional-binding-paths" class="mapping-input" @bind="_additionalBindingPaths" @bind:event="oninput" placeholder="C:\Exports\Bindings; C:\Exports\Prod.BindingInfo.xml" />
            <p class="field-hint">Semicolon-separated files or folders containing bindings exported from the BizTalk Administration Console.</p>

            <div class="action-row">
                <button class="run-button" @onclick="AnalyzeBizTalkAsync" disabled="@_isAnalyzingBizTalk">@(_isAnalyzingBizTalk ? "Analyzing..." : "Analyze source")</button>
                <button class="secondary-button" @onclick="ClearBizTalk" disabled="@_isAnalyzingBizTalk">Clear</button>
            </div>

            @if (_bizTalkAnalysis is not null)
            {
                <dl class="summary-grid summary-metadata">
                    <div>
                        <dt>Source</dt>
                        <dd>@_bizTalkAnalysis.DisplayName (@_bizTalkAnalysis.SourceType)</dd>
                    </div>
                    <div>
                        <dt>BizTalk projects</dt>
                        <dd>@_bizTalkAnalysis.BizTalkProjectCount</dd>
                    </div>
                    <div>
                        <dt>Binding files</dt>
                        <dd>@_bizTalkAnalysis.BindingFiles.Count</dd>
                    </div>
                    <div>
                        <dt>Orchestrations</dt>
                        <dd>@_bizTalkAnalysis.OrchestrationCount</dd>
                    </div>
                    <div>
                        <dt>Maps</dt>
                        <dd>@_bizTalkAnalysis.MapCount</dd>
                    </div>
                    <div>
                        <dt>Draft flows</dt>
                        <dd>@_bizTalkAnalysis.FlowCandidates.Count</dd>
                    </div>
                </dl>

                @if (_bizTalkAnalysis.Warnings.Count > 0)
                {
                    <div class="warning-panel">
                        <h3>Analysis warnings</h3>
                        <ul>
                            @foreach (var warning in _bizTalkAnalysis.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </div>
                }

                @if (_bizTalkAnalysis.FlowCandidates.Count == 0)
                {
                    <p>No draft flow candidates were generated for this source.</p>
                }
                else
                {
                    <div class="card-grid">
                        @foreach (var candidate in _bizTalkAnalysis.FlowCandidates)
                        {
                            <section class="flow-card">
                                <div class="flow-card-header">
                                    <div>
                                        <h3>@candidate.SuggestedFlowId</h3>
                                        <p><strong>Project:</strong> @candidate.SourceProject</p>
                                        @if (candidate.IsLikelyTestArtifact)
                                        {
                                            <p class="test-artifact-badge">? Looks like a test/debug artifact - confirm before migrating</p>
                                        }
                                    </div>
                                    <button class="run-button" @onclick="() => ApplyBizTalkCandidate(candidate)">Load onto canvas</button>
                                </div>
                                <p>@candidate.Summary</p>
                                <p><strong>Fetch:</strong> @candidate.FetchGuidance</p>
                                <p><strong>Parse:</strong> @candidate.ParseGuidance</p>
                                <p><strong>Augments:</strong> @FormatList(candidate.AugmentGuidance)</p>
                                <p><strong>Deliveries:</strong> @FormatList(candidate.DeliveryGuidance)</p>
                                @if (candidate.OpenQuestions.Count > 0)
                                {
                                    <p><strong>Open questions:</strong> @FormatList(candidate.OpenQuestions)</p>
                                }
                                @if (candidate.ScaffoldedModules.Count > 0)
                                {
                                    <div class="scaffolded-modules">
                                        <p>
                                            <strong>Scaffolded modules:</strong> @candidate.ScaffoldedModules.Count starter C# module(s) for decision/control-flow logic too complex to auto-translate.
                                            <button class="run-button" @onclick="() => DownloadBizTalkScaffoldedModulesAsync(candidate)">Download all (.zip)</button>
                                        </p>
                                        <ul>
                                            @foreach (var module in candidate.ScaffoldedModules)
                                            {
                                                <li>
                                                    @module.FileName <span class="muted">(@module.SourceArtifactName)</span>
                                                    <button class="run-button" @onclick="() => DownloadBizTalkScaffoldedModuleAsync(candidate, module)">Download</button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </section>
                        }
                    </div>
                }
            }
        </article>
    }

    <section class="canvas-layout">
        <aside class="side-panel">
            <h2>Flow settings</h2>
            <p class="panel-hint">Flow-level properties applied when the graph is saved.</p>

            @if (_unresolvedConfigCount > 0)
            {
                <p class="status-banner error compact">
                    @_unresolvedConfigCount unresolved config/secret reference(s) for this flow.
                    <a href="/config-values">Resolve on the Config values page</a> before enabling or running it.
                </p>
            }

            <label class="field-label" for="flow-id">Flow id</label>
            <input id="flow-id" class="mapping-input" @bind="_flowId" @bind:event="oninput" disabled="@IsExistingFlow" />

            <label class="field-label checkbox-row">
                <input type="checkbox" checked="@_enabled" @onchange="e => _enabled = (bool)(e.Value ?? false)" />
                <span>Enabled</span>
            </label>

            <label class="field-label" for="trigger-mode">Trigger mode</label>
            <select id="trigger-mode" class="selector" value="@_triggerMode" @onchange="e => _triggerMode = e.Value?.ToString() ?? _triggerMode">
                @foreach (var mode in TriggerModeOptions)
                {
                    <option value="@mode">@mode</option>
                }
            </select>

            @if (string.Equals(_triggerMode, "Interval", StringComparison.OrdinalIgnoreCase))
            {
                <label class="field-label" for="trigger-interval">Interval (hh:mm:ss)</label>
                <input id="trigger-interval" class="mapping-input" @bind="_intervalText" @bind:event="oninput" placeholder="00:05:00" />
            }

            <label class="field-label checkbox-row">
                <input type="checkbox" checked="@_runOnStartup" @onchange="e => _runOnStartup = (bool)(e.Value ?? false)" />
                <span>Run on startup</span>
            </label>

            <label class="field-label checkbox-row">
                <input type="checkbox" checked="@_hasDefaultRetry" @onchange="e => _hasDefaultRetry = (bool)(e.Value ?? false)" />
                <span>Use a default retry policy</span>
            </label>

            @if (_hasDefaultRetry)
            {
                <label class="field-label">Max attempts</label>
                <input class="mapping-input" type="number" min="1" value="@_retryMaxAttempts" @oninput="e => _retryMaxAttempts = ParseNullableInt(e.Value?.ToString())" />

                <label class="field-label">Delay (seconds)</label>
                <input class="mapping-input" type="number" min="0" step="0.5" value="@_retryDelaySeconds" @oninput="e => _retryDelaySeconds = ParseDouble(e.Value?.ToString(), _retryDelaySeconds)" />

                <label class="field-label">Backoff</label>
                <select class="selector" value="@_retryBackoff" @onchange="e => _retryBackoff = e.Value?.ToString() ?? _retryBackoff">
                    @foreach (var backoff in RetryBackoffOptions)
                    {
                        <option value="@backoff">@backoff</option>
                    }
                </select>

                <label class="field-label">Max delay (seconds, optional)</label>
                <input class="mapping-input" type="number" min="0" step="0.5" value="@_retryMaxDelaySeconds" @oninput="e => _retryMaxDelaySeconds = ParseNullableDouble(e.Value?.ToString())" />
            }

            <dl class="summary-grid summary-metadata compact-metadata">
                <div>
                    <dt>Sources</dt>
                    <dd>@(_sources.Count == 0 ? "None" : $"{_sources.Count} ({string.Join(", ", _sources.Select(source => source.Id))})")</dd>
                </div>
                <div>
                    <dt>Augments</dt>
                    <dd>@AugmentNodes.Count</dd>
                </div>
                <div>
                    <dt>Delivery routes</dt>
                    <dd>@Routes.Count</dd>
                </div>
                <div>
                    <dt>Seeded from</dt>
                    <dd>@SeedSourceLabel</dd>
                </div>
            </dl>
        </aside>

        <div class="canvas-surface">
            @if (_isLoading)
            {
                <p class="canvas-placeholder">Loading flow and module catalog...</p>
            }
            else if (_nodes.Count == 0)
            {
                <p class="canvas-placeholder">The canvas is empty. Add a source from the toolbar, or seed the graph from sample data or a BizTalk source.</p>
            }

            @if (SourceGraphError is { } graphError)
            {
                <div class="status-banner error compact">@graphError</div>
            }

            <svg @ref="_canvasElement" class="flow-canvas" width="@F(CanvasWidth)" height="@F(CanvasHeight)" viewBox="0 0 @F(CanvasWidth) @F(CanvasHeight)">
                <defs>
                    <marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrow" />
                    </marker>
                    <marker id="dependency-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrow dependency" />
                    </marker>
                </defs>

                <rect class="canvas-background" x="0" y="0" width="@F(CanvasWidth)" height="@F(CanvasHeight)" @onclick="() => _selectedNodeId = null" />

                @foreach (var source in _sources)
                {
                    var bounds = LaneBounds(source);
                    <g class="source-lane" @key="source">
                        <rect class="source-lane-body" x="@F(bounds.X)" y="@F(bounds.Y)" width="@F(bounds.Width)" height="@F(bounds.Height)" rx="18" ry="18" />
                        <text class="source-lane-label" x="@F(bounds.X + 18)" y="@F(bounds.Y + 24)">@LaneLabel(source)</text>
                    </g>
                }

                @foreach (var edge in BuildEdges())
                {
                    <path class="flow-edge @(edge.IsDependency ? "dependency" : null)"
                          data-edge-from="@edge.From.Id"
                          data-edge-to="@edge.To.Id"
                          data-edge-kind="@(edge.IsDependency ? "dependency" : "flow")"
                          d="@EdgePath(edge)"
                          marker-end="@(edge.IsDependency ? "url(#dependency-arrow)" : "url(#flow-arrow)")" />
                }

                @foreach (var node in _nodes)
                {
                    <g @key="node.Id"
                       class="flow-node stage-@node.Stage.ToString().ToLowerInvariant() @(string.Equals(node.Id, _selectedNodeId, StringComparison.Ordinal) ? "selected" : null)"
                       data-node-id="@node.Id"
                       transform="translate(@F(node.X), @F(node.Y))"
                       @onclick="() => SelectNode(node)">
                        <rect class="node-body" x="0" y="0" width="@F(NodeWidth)" height="@F(NodeHeight)" rx="14" ry="14" />
                        <text class="node-stage" x="16" y="26">@Truncate(NodeHeading(node), 24)</text>
                        <text class="node-title" x="16" y="52">@Truncate(NodeTitle(node), 26)</text>
                        <text class="node-subtitle" x="16" y="74">@NodeSubtitle(node)</text>
                    </g>
                }
            </svg>
        </div>

        <aside class="side-panel">
            @if (SelectedNode is null)
            {
                <h2>Node details</h2>
                <p class="panel-hint">Select a node on the canvas to choose its module and edit its settings.</p>
            }
            else
            {
                var node = SelectedNode;
                var catalogModule = FindCatalogModule(node.ModuleId);
                <h2>@NodeHeading(node)</h2>
                <p class="panel-hint">@StageDescription(node.Stage)</p>

                <label class="field-label">Module</label>
                <select class="selector" value="@node.ModuleId" @onchange="e => HandleNodeModuleChanged(node, e)">
                    <option value="">(select a module)</option>
                    @foreach (var module in ModulesForStage(node.Stage))
                    {
                        <option value="@module.Id">@module.DisplayName (@module.Id)</option>
                    }
                    @if (!string.IsNullOrWhiteSpace(node.ModuleId) && catalogModule is null)
                    {
                        <option value="@node.ModuleId">@node.ModuleId (not in catalog)</option>
                    }
                </select>

                @if (catalogModule is not null)
                {
                    <p class="module-description">@catalogModule.Description</p>
                }

                @if (SourceForNode(node) is { } lane)
                {
                    <h3>Source lane</h3>
                    <label class="field-label">Source id</label>
                    <input class="mapping-input" value="@lane.Id" @onchange="@(args => RenameSource(lane, args.Value?.ToString()))" />
                    <p class="field-hint">Join augments reference this id as their left/right source, and other sources reference it when they depend on this source's parsed output.</p>

                    @if (node.Stage == NodeStage.Fetch)
                    {
                        <label class="field-label">Depends on (input sources)</label>
                        @if (_sources.Count < 2)
                        {
                            <p class="field-hint">Add a second source lane to feed its parsed output into this source's fetch step.</p>
                        }
                        else
                        {
                            @foreach (var other in _sources.Where(candidate => !ReferenceEquals(candidate, lane)))
                            {
                                <label class="field-label checkbox-row" @key="other">
                                    <input type="checkbox"
                                           checked="@lane.InputSourceIds.Contains(other.Id, StringComparer.OrdinalIgnoreCase)"
                                           @onchange="@(args => ToggleSourceDependency(lane, other.Id, (bool)(args.Value ?? false)))" />
                                    <span>@other.Id</span>
                                </label>
                            }
                            <p class="field-hint">The selected sources' parsed batches are merged and handed to this fetch module as its input. The dependency graph must stay acyclic.</p>
                        }
                    }
                }

                @if (IsJoinNode(node))
                {
                    var joinEditor = EnsureJoinEditor(node);
                    var leftValue = NormalizeLeftSourceValue(node.Settings.GetValueOrDefault(LeftSourceKey));
                    var rightValue = node.Settings.GetValueOrDefault(RightSourceKey) ?? string.Empty;
                    var joinKind = string.IsNullOrWhiteSpace(node.Settings.GetValueOrDefault(JoinKindKey)) ? "Left" : node.Settings[JoinKindKey];
                    var cardinality = string.IsNullOrWhiteSpace(node.Settings.GetValueOrDefault(CardinalityKey)) ? "FanOut" : node.Settings[CardinalityKey];

                    <h3>Join inputs</h3>
                    <label class="field-label">Left source</label>
                    <select class="selector" value="@leftValue" @onchange="@(args => SetJoinSetting(node, LeftSourceKey, args.Value?.ToString()))">
                        <option value="@WorkingDocumentSelector">* (working document so far)</option>
                        @foreach (var source in _sources)
                        {
                            <option value="@source.Id">@source.Id</option>
                        }
                        @if (!string.Equals(leftValue, WorkingDocumentSelector, StringComparison.Ordinal) && FindSource(leftValue) is null)
                        {
                            <option value="@leftValue">@leftValue (unknown source)</option>
                        }
                    </select>
                    <p class="field-hint">Choose "*" to join against everything accumulated so far, which is how several joins are chained together.</p>

                    <label class="field-label">Right source *</label>
                    <select class="selector" value="@rightValue" @onchange="@(args => SetJoinSetting(node, RightSourceKey, args.Value?.ToString()))">
                        <option value="">(select a source)</option>
                        @foreach (var source in _sources)
                        {
                            <option value="@source.Id">@source.Id</option>
                        }
                        @if (!string.IsNullOrWhiteSpace(rightValue) && FindSource(rightValue) is null)
                        {
                            <option value="@rightValue">@rightValue (unknown source)</option>
                        }
                    </select>

                    <label class="field-label">Join kind</label>
                    <select class="selector" value="@joinKind" @onchange="@(args => SetJoinSetting(node, JoinKindKey, args.Value?.ToString()))">
                        @foreach (var option in JoinKindOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>

                    <label class="field-label">Result cardinality</label>
                    <select class="selector" value="@cardinality" @onchange="@(args => SetJoinSetting(node, CardinalityKey, args.Value?.ToString()))">
                        @foreach (var option in CardinalityOptions)
                        {
                            <option value="@option">@CardinalityLabel(option)</option>
                        }
                    </select>

                    @if (string.Equals(cardinality, "Nested", StringComparison.OrdinalIgnoreCase))
                    {
                        <label class="field-label">Nested target path *</label>
                        <input class="mapping-input"
                               value="@(node.Settings.GetValueOrDefault(NestedPathKey) ?? string.Empty)"
                               placeholder="order.lineItems"
                               @oninput="@(args => SetJoinSetting(node, NestedPathKey, args.Value?.ToString()))" />
                        <p class="field-hint">Where the array of mapped right rows is written on each left row, e.g. <code>order.lineItems</code>. Required for nested cardinality.</p>
                    }

                    <h3>Join keys</h3>
                    <p class="panel-hint">Every key pair must match for two rows to join. Paths use the payload path convention, e.g. <code>$.customerId</code> or <code>order.customer.id</code>.</p>
                    @if (joinEditor.Keys.Count == 0)
                    {
                        <p class="field-hint">No join keys yet. Add at least one pair.</p>
                    }
                    @foreach (var key in joinEditor.Keys)
                    {
                        <div class="inline-row" @key="key">
                            <input class="mapping-input" placeholder="@($"Left path ({JoinSideName(node, "Left")})")" value="@key.LeftPath"
                                   @oninput="@(args => SetJoinKeyPath(node, key, isLeft: true, args.Value?.ToString()))" />
                            <input class="mapping-input" placeholder="@($"Right path ({JoinSideName(node, "Right")})")" value="@key.RightPath"
                                   @oninput="@(args => SetJoinKeyPath(node, key, isLeft: false, args.Value?.ToString()))" />
                            <button class="secondary-button" @onclick="@(() => RemoveJoinKey(node, key))">Remove</button>
                        </div>
                    }
                    <div class="action-row">
                        <button class="secondary-button" @onclick="@(() => AddJoinKey(node))">Add join key</button>
                    </div>

                    <h3>Join field mappings</h3>
                    <p class="panel-hint">Each row writes one target field from the left row, the right row, or a literal JSON value.</p>
                    <table class="mapping-table">
                        <thead>
                            <tr>
                                <th>Reads from</th>
                                <th>Source path</th>
                                <th>Target field</th>
                                <th>Condition</th>
                                <th>Literal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in joinEditor.Mappings)
                            {
                                <tr @key="row">
                                    <td>
                                        <select class="selector compact" value="@row.SourceKind" @onchange="@(args => SetJoinMappingField(node, row, JoinMappingField.SourceKind, args.Value?.ToString()))">
                                            @foreach (var kind in SourceKindOptions)
                                            {
                                                <option value="@kind">@JoinSideLabel(node, kind)</option>
                                            }
                                        </select>
                                    </td>
                                    <td><input class="mapping-input" value="@row.SourcePath" @oninput="@(args => SetJoinMappingField(node, row, JoinMappingField.SourcePath, args.Value?.ToString()))" /></td>
                                    <td><input class="mapping-input" value="@row.TargetField" @oninput="@(args => SetJoinMappingField(node, row, JoinMappingField.TargetField, args.Value?.ToString()))" /></td>
                                    <td>
                                        <select class="selector compact" value="@row.Condition" @onchange="@(args => SetJoinMappingField(node, row, JoinMappingField.Condition, args.Value?.ToString()))">
                                            @foreach (var condition in ConditionOptions)
                                            {
                                                <option value="@condition">@condition</option>
                                            }
                                        </select>
                                    </td>
                                    <td><input class="mapping-input" value="@row.LiteralValue" @oninput="@(args => SetJoinMappingField(node, row, JoinMappingField.LiteralValue, args.Value?.ToString()))" /></td>
                                    <td><button class="secondary-button" @onclick="@(() => RemoveJoinMapping(node, row))">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="field-hint">Literal values are raw JSON, so text literals need quotes: <code>"enriched"</code>.</p>
                    <div class="action-row">
                        <button class="secondary-button" @onclick="@(() => AddJoinMapping(node))">Add mapping</button>
                    </div>
                }
                else
                {
                    @RenderSettingsEditor(catalogModule?.Settings, node.Settings)
                }

                var descriptorKeys = catalogModule?.Settings.Select(static setting => setting.Key).ToHashSet(StringComparer.OrdinalIgnoreCase)
                    ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                var extraKeys = node.Settings.Keys.Where(key => !descriptorKeys.Contains(key)).OrderBy(static key => key, StringComparer.OrdinalIgnoreCase).ToArray();

                @if (extraKeys.Length > 0)
                {
                    <h3>Additional settings</h3>
                    @foreach (var key in extraKeys)
                    {
                        <div class="setting-row" @key="key">
                            <label class="field-label">@key</label>
                            <div class="inline-row">
                                <input class="mapping-input" value="@node.Settings[key]" @oninput="e => node.Settings[key] = e.Value?.ToString() ?? string.Empty" />
                                <button class="secondary-button" @onclick="() => node.Settings.Remove(key)">Remove</button>
                            </div>
                        </div>
                    }
                }

                <h3>Add a setting</h3>
                <div class="inline-row">
                    <input class="mapping-input" @bind="_newSettingKey" @bind:event="oninput" placeholder="Setting key" />
                    <button class="secondary-button" @onclick="() => AddCustomSetting(node)">Add</button>
                </div>

                @if (node.Stage == NodeStage.Augment)
                {
                    <h3>Order</h3>
                    <p class="panel-hint">Augment steps run in order after every source has been fetched and parsed. Join behaviour is configured through the module's own settings.</p>
                    <div class="inline-row">
                        <button class="secondary-button" @onclick="() => MoveAugment(node, -1)">Move earlier</button>
                        <button class="secondary-button" @onclick="() => MoveAugment(node, 1)">Move later</button>
                    </div>
                }

                @if (node.Stage is NodeStage.Render or NodeStage.Deliver)
                {
                    <h3>Delivery route</h3>
                    <p class="panel-hint">Route @RouteNumber(node) pairs one render step with one deliver step.</p>
                }

                <div class="action-row">
                    @if (node.Stage is NodeStage.Render or NodeStage.Deliver)
                    {
                        <button class="secondary-button" @onclick="() => RemoveRoute(node.RouteId)">Remove route</button>
                    }
                    else if (SourceForNode(node) is { } selectedLane)
                    {
                        <button class="secondary-button" @onclick="() => RemoveSourceLane(selectedLane)">Remove source</button>
                    }
                    else
                    {
                        <button class="secondary-button" @onclick="() => RemoveNode(node)">Remove node</button>
                    }
                </div>
            }
        </aside>
    </section>

    @if (_mappingRows.Count > 0)
    {
        <article class="panel">
            <div class="panel-header">
                <div>
                    <h2>Field mappings</h2>
                    <p>Visual mappings captured from the analyzed sample. They are written into the join and map augment's field mappings when the flow is created.</p>
                </div>
                <button class="secondary-button" @onclick="AddMappingRow">Add mapping</button>
            </div>

            <table class="mapping-table">
                <thead>
                    <tr>
                        <th>Reads from</th>
                        <th>Source path</th>
                        <th>Target field</th>
                        <th>Condition</th>
                        <th>Literal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _mappingRows)
                    {
                        <tr @key="row">
                            <td>
                                <select class="selector compact" value="@row.SourceKind" @onchange="e => row.SourceKind = e.Value?.ToString() ?? row.SourceKind">
                                    @foreach (var kind in SourceKindOptions)
                                    {
                                        <option value="@kind">@kind</option>
                                    }
                                </select>
                            </td>
                            <td><input class="mapping-input" value="@row.SourcePath" @oninput="e => row.SourcePath = e.Value?.ToString() ?? string.Empty" /></td>
                            <td><input class="mapping-input" value="@row.TargetField" @oninput="e => row.TargetField = e.Value?.ToString() ?? string.Empty" /></td>
                            <td>
                                <select class="selector compact" value="@row.Condition" @onchange="e => row.Condition = e.Value?.ToString() ?? row.Condition">
                                    @foreach (var condition in ConditionOptions)
                                    {
                                        <option value="@condition">@condition</option>
                                    }
                                </select>
                            </td>
                            <td><input class="mapping-input" value="@row.LiteralValue" @oninput="e => row.LiteralValue = e.Value?.ToString() ?? string.Empty" /></td>
                            <td><button class="secondary-button" @onclick="() => _mappingRows.Remove(row)">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </article>
    }

    @if (_bizTalkRequirements.Count > 0 || _bizTalkWarnings.Count > 0)
    {
        <article class="panel">
            <div class="panel-header">
                <div>
                    <h2>BizTalk import follow-up</h2>
                    <p>Config, secret, and review items reported for the draft flow currently on the canvas.</p>
                </div>
            </div>

            @if (_bizTalkRequirements.Count > 0)
            {
                <table class="module-table">
                    <thead>
                        <tr>
                            <th>Kind</th>
                            <th>Setting</th>
                            <th>Reference</th>
                            <th>Applied</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var requirement in _bizTalkRequirements)
                        {
                            <tr>
                                <td>@requirement.Kind</td>
                                <td class="path-value">@requirement.SettingPath</td>
                                <td class="path-value">@requirement.ReferenceName</td>
                                <td>@(requirement.AppliedToDraft ? "Placeholder in draft" : "Recommendation only")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_bizTalkWarnings.Count > 0)
            {
                <div class="warning-panel">
                    <h3>Draft warnings</h3>
                    <ul>
                        @foreach (var warning in _bizTalkWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
        </article>
    }
</div>

