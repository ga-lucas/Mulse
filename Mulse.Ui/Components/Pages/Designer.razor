@page "/designer"
@page "/designer/{FlowId}"
@inject IMulseApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(IsExistingFlow ? $"Edit flow {(string.IsNullOrWhiteSpace(_flowName) ? FlowId : _flowName)}" : "Flow designer")</PageTitle>

<div class="designer-shell">
    <header class="designer-topbar">
        <div class="designer-heading">
            <p class="eyebrow">Integration builder</p>
            <h1>@(string.IsNullOrWhiteSpace(_flowName) ? IsExistingFlow ? FlowId : "New flow" : _flowName)</h1>
        </div>
        <div class="designer-topbar-actions" role="group" aria-label="Flow actions">
            @if (IsExistingFlow)
            {
                <a class="secondary-button" href="@($"/history/{Uri.EscapeDataString(FlowId!)}")">History</a>
            }
            <button class="secondary-button @(_showSamplePanel ? "active" : null)" aria-expanded="@(_showSamplePanel ? "true" : "false")" @onclick="() => { SetMappingWorkspace(false); ToggleSamplePanel(); }">Add sample data</button>
            <button class="secondary-button @(_showBizTalkPanel ? "active" : null)" aria-expanded="@(_showBizTalkPanel ? "true" : "false")" @onclick="() => { SetMappingWorkspace(false); ToggleBizTalkPanel(); }">Import from BizTalk</button>
            <button class="secondary-button" @onclick="RefreshCatalogAsync" disabled="@_isAnalyzingSample">Refresh modules</button>
            <button class="secondary-button" @onclick="AutoLayout" disabled="@(_showMappingDesigner || _showAugmentDesigner)">Auto layout</button>
            <button class="secondary-button" @onclick="ClearCanvas" disabled="@(_showMappingDesigner || _showAugmentDesigner)">Clear canvas</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="status-banner success designer-banner" role="status">@_statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="status-banner error designer-banner" role="alert">@_errorMessage</div>
    }

    @if (IsExistingFlow)
    {
        <FlowCheckpoints @key="FlowId" FlowId="@FlowId" AllowRelease="@(_enabled && _migration is null)" />
    }
    <div class="workspace-tabs" role="tablist" aria-label="Designer workspace">
        <button @ref="_flowTab" id="flow-workspace-tab" role="tab" type="button" aria-selected="@(!_showMappingDesigner && !_showAugmentDesigner ? "true" : "false")" aria-controls="flow-workspace" tabindex="@(!_showMappingDesigner && !_showAugmentDesigner ? 0 : -1)" @onclick="() => SetMappingWorkspace(false)" @onkeydown="args => HandleWorkspaceKeyAsync(args, 0)">Flow</button>
        <button @ref="_mappingTab" id="mapping-workspace-tab" role="tab" type="button" aria-selected="@(_showMappingDesigner ? "true" : "false")" aria-controls="mapping-workspace" tabindex="@(_showMappingDesigner ? 0 : -1)" @onclick="() => SetMappingWorkspace(true)" @onkeydown="args => HandleWorkspaceKeyAsync(args, 1)">Mapping</button>
        <button @ref="_augmentTab" id="augment-workspace-tab" role="tab" type="button" aria-selected="@(_showAugmentDesigner ? "true" : "false")" aria-controls="augment-workspace" tabindex="@(_showAugmentDesigner ? 0 : -1)" @onclick="SetAugmentWorkspace" @onkeydown="args => HandleWorkspaceKeyAsync(args, 2)">Augment steps</button>
    </div>
    <div class="designer-surface">
        <div id="flow-workspace" class="flow-workspace" role="tabpanel" aria-labelledby="flow-workspace-tab" hidden="@(_showMappingDesigner || _showAugmentDesigner)">
        @if (_showSamplePanel)
        {
            <FloatingPanel Title="Add a sample to the canvas" Icon="📥" X="80" Y="80" Width="420" ShowClose="true" OnClose="ToggleSamplePanel">

            <HelpTooltip Label="Sample data">A sample helps infer the data shape and parser. It is not the flow's data source and is not saved or processed by the flow. Choose the real source later in the fetch node.</HelpTooltip>
            <label class="drop-zone">
                <span>Select a sample file</span>
                <InputFile OnChange="HandleFileSelectedAsync" class="drop-zone-input" />
            </label>

            <div class="file-meta">
                <span><strong>Selected file:</strong> @(_fileName ?? "None")</span>
                <span><strong>Detected content type:</strong> @(_contentType ?? "Unknown")</span>
            </div>

            <label class="field-label" for="sample-text">Or paste sample data</label>
            <textarea id="sample-text" class="sample-textarea" @bind="_sampleText" @bind:event="oninput" placeholder="Paste JSON, XML, CSV, or raw text here."></textarea>

            <div class="action-row">
                <button class="run-button" @onclick="AnalyzeSampleAsync" disabled="@_isAnalyzingSample">@(_isAnalyzingSample ? "Analyzing..." : "Analyze sample")</button>
                <button class="secondary-button" @onclick="ClearSample" disabled="@_isAnalyzingSample">Clear sample</button>
            </div>

            @if (_analysis is not null)
            {
                <h3>Detected format: @_analysis.DetectedFormat</h3>
                <div class="preview-box">
                    <pre>@_analysis.Preview</pre>
                </div>

                <div class="suggestion-grid">
                    <section>
                        <h4>Fetch suggestions</h4>
                        <ul class="suggestion-list">
                            @foreach (var module in _analysis.FetchModules)
                            {
                                <li>@module.DisplayName <code>@module.Id</code>@(module.IsRecommended ? " - recommended" : string.Empty)</li>
                            }
                        </ul>
                    </section>
                    <section>
                        <h4>Parse suggestions</h4>
                        <ul class="suggestion-list">
                            @foreach (var module in _analysis.ParseModules)
                            {
                                <li>@module.DisplayName <code>@module.Id</code>@(module.IsRecommended ? " - recommended" : string.Empty)</li>
                            }
                        </ul>
                    </section>
                    <section>
                        <h4>Augment suggestions</h4>
                        <ul class="suggestion-list">
                            @foreach (var module in _analysis.OrchestrationAugmentModules)
                            {
                                <li>@module.DisplayName <code>@module.Id</code>@(module.IsRecommended ? " - recommended" : string.Empty)</li>
                            }
                        </ul>
                    </section>
                    <section>
                        <h4>Delivery suggestions</h4>
                        <ul class="suggestion-list">
                            @foreach (var module in _analysis.RenderModules)
                            {
                                <li>Render: @module.DisplayName <code>@module.Id</code></li>
                            }
                            @foreach (var module in _analysis.DeliverModules)
                            {
                                <li>Deliver: @module.DisplayName <code>@module.Id</code></li>
                            }
                        </ul>
                    </section>
                </div>

                <p class="field-hint">@_analysis.Fields.Count field(s) detected. Sample fields are not added as mappings automatically.</p>

                <div class="action-row">
                    <button class="run-button" @onclick="ApplySampleAnalysis">Add source to canvas</button>
                </div>
            }
        </FloatingPanel>
    }

    @if (_showBizTalkPanel)
    {
        <FloatingPanel Title="Import from BizTalk" Icon="🗂" X="80" Y="420" Width="520" ShowClose="true" OnClose="ToggleBizTalkPanel">

            <label class="field-label" for="source-path">Source path</label>
            <input id="source-path" class="mapping-input" @bind="_sourcePath" @bind:event="oninput" placeholder="C:\Users\...\MyBizTalkApp.sln" />
            <HelpTooltip Label="BizTalk source path">Choose a solution, project, directory, or .odx file. An .odx file must be explicitly included by exactly one .btproj in the same folder; its whole project is analyzed. Choose the desired orchestration candidate below.</HelpTooltip>

            <label class="field-label" for="additional-source-paths">Additional solutions/projects (optional)</label>
            <input id="additional-source-paths" class="mapping-input" @bind="_additionalSourcePaths" @bind:event="oninput" placeholder="C:\...\Partners.sln; C:\...\Core.sln" />
            <HelpTooltip Label="Additional sources">Semicolon-separated additional solution, project, or directory paths analyzed alongside the source path as one combined workspace.</HelpTooltip>

            <label class="field-label" for="additional-binding-paths">Additional binding export paths (optional)</label>
            <input id="additional-binding-paths" class="mapping-input" @bind="_additionalBindingPaths" @bind:event="oninput" placeholder="C:\Exports\Bindings; C:\Exports\Prod.BindingInfo.xml" />
            <HelpTooltip Label="Binding exports">Semicolon-separated files or folders containing bindings exported from the BizTalk Administration Console.</HelpTooltip>

            <label class="field-label" for="additional-rule-paths">Rule policy XML exports (optional)</label>
            <input id="additional-rule-paths" class="mapping-input" @bind="_additionalRulePaths" @bind:event="oninput" placeholder="C:\Exports\rules.xml" />
            <p class="field-hint">Semicolon-separated BRL export files. Versions and client rules are separate: each version can contain rules for many clients. No deployed version is inferred.</p>

            <label class="field-label"><input type="checkbox" @bind="_generateNativeBizTalkFlow" /> Generate native control-flow draft</label>
            <p class="field-hint">Uses native ordered nodes and exact logical port bindings. Unsupported statements/components remain explicit blockers. Does not execute ODX or approve imported execution.</p>
            <p class="field-hint">BizTalk development tools and golden-output fixtures are optional, not import prerequisites. Native map replacements can be configured through renderer choices after loading a draft. Unsupported source transforms remain blockers until their native wiring is implemented; replacement configuration alone does not establish parity.</p>
            @if (_generateNativeBizTalkFlow)
            {
                <details><summary>Native map replacement choices (optional)</summary>
                    <label class="field-label"><input type="checkbox" id="derive-native-map-choices" @bind="_deriveNativeMapChoices" /> Derive choices from the policy exports</label>
                    <p class="field-hint">Matches each literal *MapName value in the rule exports to a map in the analyzed projects and converts maps that contain only direct links and constants. Values that cannot be proven are listed after analysis with the reason and stay fail-closed; add them manually below. Explicit choices below win over derived ones. Needs rule exports and the project that owns the maps in the source paths.</p>
                    <p class="field-hint">Use the exact map-name String returned by the selected policy, including any assembly qualification. Choices explicitly select native replacements, not verified deployed map equivalents. Complete supported dynamic transform statements use these choices; unsupported statements remain blocked. Reanalyze after editing choices.</p>
                    <RenderDispatchEditor Settings="_nativeMapSettings" Modules="_modules" NativeSelectionMode="true" Changed="BizTalkMapChoicesChanged" />
                </details>
                <label class="field-label">Host configuration test snapshot (optional)
                    <input class="mapping-input" @bind="_nativeHostConfigurationPath" placeholder="C:\Exports\BTSNTSvc64.exe.config" />
                </label>
                <label class="field-label">Pure configuration getter source files
                    <input class="mapping-input" @bind="_nativeConfigurationHelperPaths" placeholder="C:\Source\Settings.cs" />
                </label>
                <p class="field-hint">Explicit local paths, semicolon-separated helper .cs files (maximum 16). Only complete literal-key appSettings getters with an empty-string missing-key return can become pinned scalar values. No assembly or external configuration is loaded. Absent keys remain empty, not invented patterns. Values referenced by imported code are saved in editable native literals: use nonsensitive settings only. This selects test evidence, not proof of deployed helper identity.</p>
            }
            <div class="action-row">
                <button class="run-button" @onclick="AnalyzeBizTalkAsync" disabled="@_isAnalyzingBizTalk">@(_isAnalyzingBizTalk ? "Analyzing..." : "Analyze source")</button>
                <button class="secondary-button" @onclick="ClearBizTalk" disabled="@_isAnalyzingBizTalk">Clear</button>
            </div>

            @if (_bizTalkAnalysis is not null)
            {
                @if (!BizTalkAnalysisIsCurrent)
                {
                    <p class="status-banner error" role="alert">Import settings changed since analysis. Analyze again before loading or downloading a candidate.</p>
                }
                <dl class="summary-grid summary-metadata">
                    <div>
                        <dt>Source</dt>
                        <dd>@_bizTalkAnalysis.DisplayName (@_bizTalkAnalysis.SourceType)</dd>
                    </div>
                    <div>
                        <dt>BizTalk projects</dt>
                        <dd>@_bizTalkAnalysis.BizTalkProjectCount</dd>
                    </div>
                    <div>
                        <dt>Binding files</dt>
                        <dd>@_bizTalkAnalysis.BindingFiles.Count</dd>
                    </div>
                    <div>
                        <dt>Orchestrations</dt>
                        <dd>@_bizTalkAnalysis.OrchestrationCount</dd>
                    </div>
                    <div>
                        <dt>Maps</dt>
                        <dd>@_bizTalkAnalysis.MapCount</dd>
                    </div>
                    <div>
                        <dt>Draft flows</dt>
                        <dd>@_bizTalkAnalysis.FlowCandidates.Count</dd>
                    </div>
                </dl>

                @if (_bizTalkAnalysis.Warnings.Count > 0)
                {
                    <div class="warning-panel">
                        <h3>Analysis warnings</h3>
                        <ul>
                            @foreach (var warning in _bizTalkAnalysis.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </div>
                }

                <BizTalkDependencyReport Projects="_bizTalkAnalysis.BizTalkProjects" />

                <BizTalkDerivedMapChoices Choices="_bizTalkAnalysis.DerivedMapChoices" CanUse="@(_bizTalkAnalysis.EffectiveMapChoicesJson is not null)" OnUseAsExplicit="UseDerivedMapChoicesAsExplicit" />
                <BizTalkRulePolicies Policies="_bizTalkAnalysis.RulePolicies" OnAddPolicy="AddImportedRulePolicy" EnableNativeTargets="@(_generateNativeBizTalkFlow && !_isAnalyzingBizTalk)" OnSelectNativeTarget="SelectNativePolicyTarget" />
                @if (_generateNativeBizTalkFlow && _nativePolicyVersions.Count > 0)
                {
                    <p class="field-hint">Explicit native policy test targets: @string.Join(", ", _nativePolicyVersions.Select(pair => pair.Key + " " + pair.Value)). These selections are pinned in newly generated nodes, not deployed-version assertions.</p>
                    <button class="secondary-button" disabled="@_isAnalyzingBizTalk" @onclick="ClearNativePolicyTargets">Clear native policy targets and reanalyze</button>
                }

                @if (_bizTalkAnalysis.FlowCandidates.Count == 0)
                {
                    <p>No draft flow candidates were generated for this source.</p>
                }
                else
                {
                    <div class="card-grid">
                        @foreach (var candidate in _bizTalkAnalysis.FlowCandidates)
                        {
                            <section class="flow-card">
                                <div class="flow-card-header">
                                    <div>
                                        <h3>@candidate.SuggestedFlowId</h3>
                                        <p><strong>Project:</strong> @candidate.SourceProject</p>
                                        <p class="path-value">@candidate.SourceProjectPath</p>
                                        @if (candidate.IsLikelyTestArtifact)
                                        {
                                            <p class="test-artifact-badge">? Looks like a test/debug artifact - confirm before migrating</p>
                                        }
                                    </div>
                                    <button class="run-button" disabled="@(!BizTalkAnalysisIsCurrent)" @onclick="() => ApplyBizTalkCandidate(candidate)">Load onto canvas</button>
                                </div>
                                <p>@candidate.Summary</p>
                                @if (candidate.DraftFlow.Migration is { } migration)
                                {
                                    <MigrationReport Report="migration" />
                                }
                                <p><strong>Fetch:</strong> @candidate.FetchGuidance</p>
                                <p><strong>Parse:</strong> @candidate.ParseGuidance</p>
                                <p><strong>Augments:</strong> @FormatList(candidate.AugmentGuidance)</p>
                                <p><strong>Deliveries:</strong> @FormatList(candidate.DeliveryGuidance)</p>
                                @if (candidate.OpenQuestions.Count > 0)
                                {
                                    <p><strong>Open questions:</strong> @FormatList(candidate.OpenQuestions)</p>
                                }
                                @if (candidate.DraftFlow.Migration?.SourceOrchestration is not null)
                                {
                                    <p><button class="secondary-button" disabled="@(!BizTalkAnalysisIsCurrent)" @onclick="() => DownloadBizTalkControlFlowAsync(candidate)">Download developer control-flow model (.json)</button></p>
                                    <p class="field-hint">Explicit source export includes expressions and literal property values. Handle as private source code. The SDK can execute bound branches/loops/local catches, but activities, durable waits and transaction boundaries require developer implementation. Downloading does not approve execution.</p>
                                }
                                @if (candidate.ScaffoldedModules.Count > 0)
                                {
                                    <div class="scaffolded-modules">
                                        <p>
                                            <strong>Scaffolded modules:</strong> @candidate.ScaffoldedModules.Count starter artifact(s): C# stubs, automatically bound ODX source, per-node translation reports and partial map stylesheets. ODX C# includes original expressions and literals; handle as private source code. C# stubs fail until implemented; unsupported bindings still block execution. Downloading/building does not approve execution.
                                            <button class="run-button" disabled="@(!BizTalkAnalysisIsCurrent)" @onclick="() => DownloadBizTalkScaffoldedModulesAsync(candidate)">Download all (.zip)</button>
                                        </p>
                                        <ul>
                                            @foreach (var module in candidate.ScaffoldedModules)
                                            {
                                                <li>
                                                    @module.FileName <span class="muted">(@module.SourceArtifactName)</span>
                                                    <button class="run-button" disabled="@(!BizTalkAnalysisIsCurrent)" @onclick="() => DownloadBizTalkScaffoldedModuleAsync(candidate, module)">Download</button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </section>
                        }
                    </div>
                }
            }
        </FloatingPanel>
    }

    <aside class="designer-left-dock" aria-label="Flow tools and overview" @ref="_leftDock" style="--toolbox-share: @F(_toolboxShare)fr; --overview-share: @F(100 - _toolboxShare)fr">
    <section id="designer-toolbox" class="dock-panel toolbox-panel" aria-labelledby="toolbox-heading">
        <h2 id="toolbox-heading" class="dock-heading">Toolbox</h2>
        <div class="dock-body">
        <HelpTooltip Label="Toolbox and connections">Click or drag tools onto the canvas. Solid arrows carry batches. Dashed arrows supply lookup inputs. BATCH combines payloads, not matching rows; use Join sources to join by key.</HelpTooltip>
        <div class="toolbox-list" @ref="_toolboxElement">
            <button class="toolbox-item" data-node-type="source" data-node-label="Source" @onclick="AddSourceLane" title="Adds a new source: a fetch node plus a parse node that parses it, pre-linked. Join augments and other fetch nodes reference the parse node's id.">
                <span class="toolbox-icon">⭘→</span> Source
            </button>
            <button class="toolbox-item" data-node-type="fetch" data-node-label="Extra fetch" @onclick="AddFetchNode" title="Adds a standalone fetch node. Drop it onto an existing source lane (or click it while a parse node is selected) to have that parse node also parse this fetch's raw output.">
                <span class="toolbox-icon">⭘+</span> Extra fetch
            </button>
            <button class="toolbox-item" data-node-type="parse" data-node-label="Parser" @onclick="AddParseNode" title="Adds a parser without another fetch. Select a fetch first, or drop onto it, to link its output. With no selection, a sole unparsed fetch is linked automatically.">
                <span class="toolbox-icon">◇</span> Parser
            </button>
            <button class="toolbox-item" data-node-type="augment" data-node-label="Augment" @onclick="AddAugmentNode">
                <span class="toolbox-icon">◇</span> Augment
            </button>
            <button class="toolbox-item" data-node-type="control-flow" data-node-label="Control flow" @onclick="AddNativeAugment" title="Adds a native augment with visually editable sequences, branches, loops and message operations.">
                <span class="toolbox-icon">&#8627;</span> Control flow
            </button>
            <button class="toolbox-item" data-node-type="join" data-node-label="Join sources" @onclick="AddJoinAugmentNode" disabled="@(ParseNodes.Count < 2)" title="Adds a multi-source join and map augment, pre-wired to the first two parse nodes on the canvas.">
                <span class="toolbox-icon">⋈</span> Join sources
            </button>
            <button class="toolbox-item" data-node-type="parsed-map" data-node-label="Map parsed data" @onclick="AddParsedDataMapping" title="Maps fields after any parser, before rendering. Define fields manually or discover them from supplied sample or parsed data.">
                <span class="toolbox-icon">&#8594;</span> Map parsed data
            </button>
            <button class="toolbox-item" data-node-type="render" data-node-label="Render" @onclick="AddRenderNode" title="Adds a render to a selected route missing one, or creates a new render-only route. Add a deliver node before saving.">
                <span class="toolbox-icon">◇</span> Render
            </button>
            <button class="toolbox-item" data-node-type="route" data-node-label="Delivery route" @onclick="AddDeliveryRoute">
                <span class="toolbox-icon">⑂→</span> Delivery route
            </button>
            <button class="toolbox-item" data-node-type="deliver" data-node-label="Extra deliver" @onclick="AddDeliverNode" disabled="@(Routes.Count == 0)" title="Adds another deliver node to an existing delivery route, so the route's single render output is also delivered here. Drop it onto a route (or click it while one of the route's nodes is selected). Each deliver node runs independently.">
                <span class="toolbox-icon">⑂+</span> Extra deliver
            </button>
        </div>
        @if (AugmentNodes.Any(IsJoinNode))
        {
            <h3>Join steps</h3>
            @foreach (var join in AugmentNodes.Where(IsJoinNode))
            {
                <div @key="join.Id">
                    <p class="field-hint">@NodeHeading(join)</p>
                    <div class="action-row">
                        <button class="secondary-button" @onclick="() => SelectNode(join)" aria-label="@($"Configure {NodeHeading(join)}")">Configure join</button>
                        <button class="secondary-button" @onclick="() => RemoveCanvasNode(join)" aria-label="@($"Remove {NodeHeading(join)}")">Remove join</button>
                    </div>
                </div>
            }
        }
        </div>
    </section>
    <div @ref="_dockSplitter" class="dock-splitter" role="separator" tabindex="0" aria-label="Resize Toolbox and Flow overview" title="Drag to resize; use Up/Down or Home/End when focused" aria-orientation="horizontal" aria-controls="designer-toolbox designer-overview" aria-valuemin="20" aria-valuemax="80" aria-valuenow="@F(_toolboxShare)" @onkeydown="ResizeDockByKey"></div>
    <section id="designer-overview" class="dock-panel" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="dock-heading">Flow overview</h2>
        <div class="dock-body">
        @if (_unresolvedConfigCount > 0)
        {
            <p class="status-banner error compact">
                @_unresolvedConfigCount unresolved config/secret reference(s) for this flow.
                <a href="/config-values">Resolve on the Config values page</a> before enabling or running it.
            </p>
        }

        <label class="field-label" for="flow-name">Flow name</label>
        <input id="flow-name" class="mapping-input" @bind="_flowName" @bind:event="oninput" placeholder="e.g. Import customer orders" />
        <HelpTooltip Label="Flow name">An editable display name. Leave blank to display the flow ID.</HelpTooltip>

        <label class="field-label" for="flow-id">Flow ID</label>
        <input id="flow-id" class="mapping-input" @bind="_flowId" @bind:event="oninput" disabled="@IsExistingFlow" />
        <HelpTooltip Label="Flow ID">Unique technical identifier used in URLs and API calls; fixed after creation.</HelpTooltip>

        <label class="field-label checkbox-row">
            <input type="checkbox" checked="@_enabled" @onchange="e => _enabled = (bool)(e.Value ?? false)" disabled="@(_migration is not null && !_enabled)" />
            <span>Enabled</span>
        </label>
        @if (_migration is not null)
        {
            <p class="status-banner error compact">@FlowMigrationReportViewModel.ExecutionBlockReason You can still edit and save a disabled draft.</p>
        }

        <label class="field-label" for="trigger-mode">Trigger mode</label>
        <select id="trigger-mode" class="selector" value="@_triggerMode" @onchange="e => _triggerMode = e.Value?.ToString() ?? _triggerMode">
            @foreach (var mode in TriggerModeOptions)
            {
                <option value="@mode">@mode</option>
            }
        </select>

        <HelpTooltip Label="Trigger mode">@TriggerGuidance</HelpTooltip>
        @if (string.Equals(_triggerMode, "Push", StringComparison.OrdinalIgnoreCase) && PushTriggerFetch is null)
        {
            <p class="status-banner error compact">Push requires a loaded push-capable fetch module. SFTP alone cannot trigger this flow.</p>
        }
        @if (!string.Equals(_triggerMode, "Push", StringComparison.OrdinalIgnoreCase) && FetchNodes.Any(fetch => fetch.ModuleId == "file-system-watcher-fetch"))
        {
            <p class="field-hint">File system watcher events will not start this flow in this mode. Prefer Push for watching, or file-system-fetch with Interval for periodic directory scans.</p>
        }

        @if (string.Equals(_triggerMode, "Interval", StringComparison.OrdinalIgnoreCase))
        {
            <label class="field-label" for="trigger-interval">Interval (hh:mm:ss)</label>
            <input id="trigger-interval" class="mapping-input" @bind="_intervalText" @bind:event="oninput" placeholder="00:05:00" />
        }

        <label class="field-label checkbox-row">
            <input type="checkbox" checked="@_runOnStartup" disabled="@(!string.Equals(_triggerMode, "Interval", StringComparison.OrdinalIgnoreCase))" @onchange="e => _runOnStartup = (bool)(e.Value ?? false)" />
            <span>Run on startup (Interval only)</span>
        </label>

        <label class="field-label checkbox-row">
            <input type="checkbox" @bind="_hasDefaultRetry" />
            <span>Use a default retry policy</span>
        </label>

        @if (_hasDefaultRetry)
        {
            <label class="field-label">Max attempts</label>
            <input class="mapping-input" type="number" min="1" value="@_retryMaxAttempts" @oninput="e => _retryMaxAttempts = ParseNullableInt(e.Value?.ToString())" />

            <label class="field-label">Delay (seconds)</label>
            <input class="mapping-input" type="number" min="0" step="0.5" value="@_retryDelaySeconds" @oninput="e => _retryDelaySeconds = ParseDouble(e.Value?.ToString(), _retryDelaySeconds)" />

            <label class="field-label">Backoff</label>
            <select class="selector" value="@_retryBackoff" @onchange="e => _retryBackoff = e.Value?.ToString() ?? _retryBackoff">
                @foreach (var backoff in RetryBackoffOptions)
                {
                    <option value="@backoff">@backoff</option>
                }
            </select>

            <label class="field-label">Max delay (seconds, optional)</label>
            <input class="mapping-input" type="number" min="0" step="0.5" value="@_retryMaxDelaySeconds" @oninput="e => _retryMaxDelaySeconds = ParseNullableDouble(e.Value?.ToString())" />
        }


        <dl class="summary-grid summary-metadata compact-metadata">
            <div>
                <dt>Parse nodes</dt>
                <dd>@(ParseNodes.Count == 0 ? "None" : $"{ParseNodes.Count} ({string.Join(", ", ParseNodes.Select(parse => parse.GraphId))})")</dd>
            </div>
            <div>
                <dt>Fetch nodes</dt>
                <dd>@(FetchNodes.Count == 0 ? "None" : $"{FetchNodes.Count} ({string.Join(", ", FetchNodes.Select(fetch => fetch.GraphId))})")</dd>
            </div>
            <div>
                <dt>Augments</dt>
                <dd>@AugmentNodes.Count</dd>
            </div>
            <div>
                <dt>Delivery routes</dt>
                <dd>@Routes.Count</dd>
            </div>
            <div>
                <dt>Seeded from</dt>
                <dd>@SeedSourceLabel</dd>
            </div>
        </dl>
        </div>
    </section>
    </aside>

    <div class="canvas-surface">
        <InputFile @ref="_canvasFileInput" OnChange="HandleCanvasFilesAsync" multiple hidden disabled="@_isAnalyzingSample" />
        @if (_isLoading)
        {
            <p class="canvas-placeholder">Loading flow and module catalog...</p>
        }
        else if (_nodes.Count == 0)
        {
            <p class="canvas-placeholder">Drop JSON, XML, CSV, text, XLS or XLSX samples here to infer a source shape. Configure the real source later, or add a node from the toolbox.</p>
        }

        @if (SourceGraphError is { } graphError)
        {
            <div class="status-banner error compact">@graphError</div>
        }
        @if (_isAnalyzingSample)
        {
            <p class="canvas-placeholder" role="status">Analyzing sample files...</p>
        }

        <div class="canvas-connection-help">
            @if (_connectionFromId is not null)
            {
                <span role="status">Choose an input handle to connect.</span>
                <button type="button" class="secondary-button" @onclick="() => _connectionFromId = null">Cancel connection</button>
            }
            else
            {
                <span>Connect sources: click output then input, or drag between the handles. Select a node for all settings.</span>
            }
        </div>
        <div class="zoom-controls" role="group" aria-label="Canvas zoom">
            <button class="secondary-button" @onclick="ZoomOutAsync" title="Zoom out" aria-label="Zoom out">−</button>
            <span class="zoom-label">@ZoomPercentLabel</span>
            <button class="secondary-button" @onclick="ZoomInAsync" title="Zoom in" aria-label="Zoom in">+</button>
            <button class="secondary-button" @onclick="FitView" title="Reset to fit">Fit</button>
        </div>

        <svg @ref="_canvasElement" class="flow-canvas" width="100%" height="100%" viewBox="@F(_viewX) @F(_viewY) @F(_viewW) @F(_viewH)" @onclick="() => _selectedNodeId = null" @onkeydown="HandleCanvasKey">
            <defs>
                <marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrow" />
                </marker>
                <marker id="dependency-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrow dependency" />
                </marker>
            </defs>

            @foreach (var parse in ParseNodes)
            {
                var bounds = LaneBounds(parse);
                <g class="source-lane" @key="parse" data-lane-members="@string.Join(" ", LaneMembers(parse).Select(member => member.Id))">
                    <rect class="source-lane-body" x="@F(bounds.X)" y="@F(bounds.Y)" width="@F(bounds.Width)" height="@F(bounds.Height)" rx="18" ry="18" />
                    <rect class="source-lane-handle" x="@F(bounds.X + 8)" y="@F(bounds.Y + 6)" width="@F(bounds.Width - 16)" height="22" rx="8" ry="8">
                        <title>Drag this header to move the source group, including shared fetch nodes. Other groups containing shared nodes resize to match.</title>
                    </rect>
                    <foreignObject class="source-lane-label" x="@F(bounds.X + 18)" y="@F(bounds.Y + 6)" width="@F(bounds.Width - 36)" height="22">
                        <div class="source-lane-caption" title="@LaneLabel(parse)">@LaneLabel(parse)</div>
                    </foreignObject>
                </g>
            }

            @foreach (var edge in BuildEdges())
            {
                <path class="flow-edge @(edge.IsDependency ? "dependency" : null)"
                      data-edge-from="@edge.From.Id"
                      data-edge-to="@edge.To.Id"
                      data-edge-kind="@(edge.IsDependency ? "dependency" : "flow")"
                      d="@EdgePath(edge)"
                      marker-end="@(edge.IsDependency ? "url(#dependency-arrow)" : "url(#flow-arrow)")">
                    <title>@(edge.IsDependency ? $"Lookup input: parsed rows from {NodeHeading(edge.From)} supply {NodeHeading(edge.To)}. This does not join rows." : $"Batch flow: {NodeHeading(edge.From)} to {NodeHeading(edge.To)}.")</title>
                </path>
            }

            @{
                var incoming = IncomingEdgeCounts();
                var outgoing = OutgoingEdgeCounts();
            }
            @foreach (var node in _nodes)
            {
                var incomingCount = incoming.GetValueOrDefault(node.Id);
                var outgoingCount = outgoing.GetValueOrDefault(node.Id);
                <g @key="node.Id"
                   class="flow-node stage-@node.Stage.ToString().ToLowerInvariant() @(string.Equals(node.Id, _selectedNodeId, StringComparison.Ordinal) ? "selected" : null)"
                   data-node-id="@node.Id"
                   tabindex="0" role="group" aria-label="@($"{NodeHeading(node)}: {NodeTitle(node)}. Press Enter to edit properties.")"
                   transform="translate(@F(node.X), @F(node.Y))"
                   @onkeydown="args => SelectNodeByKey(node, args)"
                   @onclick="() => SelectNode(node)" @onclick:stopPropagation="true">
                    <rect class="node-body" x="0" y="0" width="@F(NodeWidth)" height="@F(NodeHeight)" rx="14" ry="14" />
                    <text class="node-stage" x="16" y="26">@Truncate(NodeHeading(node), 18)</text>
                    <text class="node-title" x="16" y="52">@Truncate(NodeTitle(node), 26)</text>
                    <text class="node-subtitle" x="16" y="74">@(IsNativeAugment(node) ? "Control flow" : NodeSubtitle(node))</text>
                    @if (IsNativeAugment(node))
                    {
                        <foreignObject x="112" y="60" width="90" height="30">
                            <button type="button" class="node-edit-steps" aria-label="@("Edit steps in " + NodeHeading(node))" @onclick="() => OpenAugmentDesigner(node)" @onclick:stopPropagation @onkeydown:stopPropagation>Edit steps</button>
                        </foreignObject>
                    }
                    @if (node.Stage is NodeStage.Fetch or NodeStage.Parse)
                    {
                        <foreignObject x="-14" y="32" width="28" height="32">
                            <button type="button" class="node-port input-port" aria-label="@($"Connect to input of {NodeHeading(node)}")" title="Connect selected output here, or drop an output handle here"
                                    @onclick="() => CompleteConnection(node)" @onclick:stopPropagation>&#8594;</button>
                        </foreignObject>
                        <foreignObject x="@F(NodeWidth - 14)" y="32" width="28" height="32">
                            <button type="button" class="node-port output-port" draggable="true" aria-label="@($"Connect from output of {NodeHeading(node)}")" aria-pressed="@(_connectionFromId == node.Id)" title="Click then choose an input, or drag to an input handle"
                                    @onclick="() => StartConnection(node)" @onclick:stopPropagation>&#8594;</button>
                        </foreignObject>
                    }
                    <foreignObject x="@F(NodeWidth - 34)" y="4" width="30" height="30">
                        <button type="button" class="node-remove" aria-label="@($"Remove {NodeHeading(node)}")"
                                title="Remove only this node. Connected nodes stay; incomplete connections must be repaired before saving."
                                @onclick="() => RemoveCanvasNode(node)" @onclick:stopPropagation="true" @onkeydown:stopPropagation>
                            <span aria-hidden="true">&#215;</span>
                        </button>
                    </foreignObject>
                    @if (incomingCount >= 2)
                    {
                        <g class="badge-group">
                            <title>@(IsJoinNode(node) ? "Join sources matches rows using the configured keys and field mappings." : "Incoming payloads share a batch. No row matching happens here.")</title>
                            <circle class="merge-dot" cx="0" cy="@F(NodeHeight / 2)" r="6" />
                            <text class="join-badge" x="-6" y="@F(NodeHeight + 14)">@IncomingBatchLabel(node, incomingCount)</text>
                        </g>
                    }
                    @if (outgoingCount >= 2)
                    {
                        <g class="badge-group">
                            <title>This output has @outgoingCount uses, including lookup inputs. Rows are not split or removed.</title>
                            <circle class="fork-dot" cx="@F(NodeWidth)" cy="@F(NodeHeight / 2)" r="6" />
                            <text class="split-badge" x="@F(NodeWidth - 70)" y="@F(NodeHeight + 14)">USES ×@outgoingCount</text>
                        </g>
                    }
                </g>
            }
        </svg>
    </div>

    <aside class="designer-properties dock-panel" aria-labelledby="properties-heading">
        <h2 id="properties-heading" class="dock-heading">Properties</h2>
        <div class="dock-body">
        @if (SelectedNode is null)
        {
            <p class="panel-hint">Select a node on the canvas to choose its module and edit its settings.</p>
        }
        else
        {
            var node = SelectedNode;
            var catalogModule = FindCatalogModule(node.ModuleId);
            <h3>@NodeHeading(node)</h3>
            <HelpTooltip Label="Node stage">@StageDescription(node.Stage)</HelpTooltip>
            @if (IsJoinNode(node))
            {
                <button class="secondary-button" @onclick="() => RemoveCanvasNode(node)">Remove join</button>
                <HelpTooltip Label="Remove join">Removing this join keeps the sources, render and deliver nodes. Configure its keys and mappings below.</HelpTooltip>
            }
            @if (node.Stage == NodeStage.Render)
            {
                <h3>Incoming batch</h3>
                <HelpTooltip Label="Incoming batch">All parsed sources feed the ordered augment chain, then this render. Converging arrows are automatic batch wiring, not a removable join. Add or configure a Join sources step to match rows by key.</HelpTooltip>
                @foreach (var join in AugmentNodes.Where(IsJoinNode))
                {
                    <button class="secondary-button" @onclick="() => SelectNode(join)">Configure @NodeHeading(join)</button>
                }
                <button class="secondary-button" @onclick="AddJoinAugmentNode" disabled="@(ParseNodes.Count < 2)">Add join sources</button>
            }
            <HelpTooltip Label="Setting references">Type <code>{{</code> in a module setting for config/secret suggestions. Use Up/Down and Enter/Tab, or click a suggestion.</HelpTooltip>
            <a href="/config-values">Manage stored values</a>

            <label class="field-label">Name</label>
            <input class="mapping-input" placeholder="@DefaultNodeHeading(node)" value="@node.Name"
                   @onchange="@(args => { node.Name = args.Value?.ToString(); })" />

            <label class="field-label">Module</label>
            <select class="selector" value="@node.ModuleId" @onchange="e => HandleNodeModuleChanged(node, e)">
                <option value="">(select a module)</option>
                @foreach (var module in ModulesForStage(node.Stage))
                {
                    <option value="@module.Id">@module.DisplayName (@module.Id)</option>
                }
                @if (!string.IsNullOrWhiteSpace(node.ModuleId) && catalogModule is null)
                {
                    <option value="@node.ModuleId">@node.ModuleId (not in catalog)</option>
                }
            </select>

            @if (catalogModule is not null)
            {
                <HelpTooltip Label="Module description">@catalogModule.Description</HelpTooltip>
            }

            @if (node.Stage == NodeStage.Fetch)
            {
                var parsedBy = ParsesForFetch(node);
                <h3>Fetch node</h3>
                <label class="field-label">Fetch node id</label>
                <input class="mapping-input" value="@node.GraphId" @onchange="@(args => RenameGraphNode(node, args.Value?.ToString()))" />
                <HelpTooltip Label="Fetch node identity">Parse nodes reference this id to interpret this fetch's output. Fetch and parse node ids share one namespace.</HelpTooltip>
                <h3>Execution and trigger</h3>
                <HelpTooltip Label="Fetch execution and trigger">@FetchTriggerGuidance(node)</HelpTooltip>
                @if (node.ModuleId == "sql-server-lookup-fetch")
                {
                    <HelpTooltip Label="SQL lookup output">SQL lookup emits a JSON array of rows, not an Excel file or database reader. Use JSON parse to validate/normalize it and name the row source for a join. Parsing does not rerun the query or match rows; configure Join sources separately.</HelpTooltip>
                }

                <label class="field-label">Parsed by (parse nodes)</label>
                <button class="secondary-button" @onclick="() => AddParseForFetch(node)">Add parser for this fetch</button>
                @if (ParseNodes.Count == 0)
                {
                    <p class="field-hint">Use Add parser for this fetch or the Parser toolbox item; the existing fetch and its settings are kept.</p>
                }
                else
                {
                    @foreach (var parse in ParseNodes)
                    {
                        <label class="field-label checkbox-row" @key="(ParsedByKey: parse.Id, 0)">
                            <input type="checkbox"
                                   checked="@parsedBy.Contains(parse)"
                                   @onchange="@(args => ToggleParseFetchLink(parse, node.GraphId, (bool)(args.Value ?? false)))" />
                            <span>@parse.GraphId</span>
                        </label>
                    }
                    <HelpTooltip Label="Fetch parsers">Every selected parse node parses this fetch's raw batch with its own module and settings. A fetch must be parsed by at least one parse node.</HelpTooltip>
                }

                <label class="field-label">Input from (parsed output of)</label>
                @if (ParseNodes.Count == 0)
                {
                    <p class="field-hint">Add a parse node to feed its finished output into this fetch step.</p>
                }
                else
                {
                    @foreach (var parse in ParseNodes)
                    {
                        <label class="field-label checkbox-row" @key="(InputFromKey: parse.Id, 1)">
                            <input type="checkbox"
                                   checked="@node.InputParseIds.Contains(parse.GraphId, StringComparer.OrdinalIgnoreCase)"
                                   @onchange="@(args => ToggleFetchInputParse(node, parse.GraphId, (bool)(args.Value ?? false)))" />
                            <span>@parse.GraphId</span>
                        </label>
                    }
                    <HelpTooltip Label="Fetch inputs">The selected parse nodes' finished batches are merged and handed to this fetch module as its input (e.g. for lookups). The source graph must stay acyclic.</HelpTooltip>
                }
            }

            @if (node.Stage == NodeStage.Parse)
            {
                <h3>Parse node</h3>
                <label class="field-label">Parse node id</label>
                <input class="mapping-input" value="@node.GraphId" @onchange="@(args => RenameGraphNode(node, args.Value?.ToString()))" />
                <HelpTooltip Label="Parse node identity">Payloads this node produces are tagged with this source id. Joins reference it as their left/right source; fetch nodes reference it when taking this node's output as input.</HelpTooltip>

                <label class="field-label">Parses raw output of (fetch nodes)</label>
                @if (FetchNodes.Count == 0)
                {
                    <p class="field-hint">Add a fetch node (the Extra fetch toolbox item) for this parse node to parse.</p>
                }
                else
                {
                    @foreach (var fetch in FetchNodes)
                    {
                        <label class="field-label checkbox-row" @key="fetch">
                            <input type="checkbox"
                                   checked="@node.FetchNodeIds.Contains(fetch.GraphId, StringComparer.OrdinalIgnoreCase)"
                                   @onchange="@(args => ToggleParseFetchLink(node, fetch.GraphId, (bool)(args.Value ?? false)))" />
                            <span>@fetch.GraphId</span>
                        </label>
                    }
                    <HelpTooltip Label="Parse inputs">Each selected fetch's raw batch is parsed separately with this module and settings, then merged into this node's single output. Select at least one.</HelpTooltip>
                }
            }

                @if (IsJoinNode(node))
                {
                    var joinEditor = EnsureJoinEditor(node);
                    var leftValue = NormalizeLeftSourceValue(node.Settings.GetValueOrDefault(LeftSourceKey));
                    var rightValue = node.Settings.GetValueOrDefault(RightSourceKey) ?? string.Empty;
                    var joinKind = string.IsNullOrWhiteSpace(node.Settings.GetValueOrDefault(JoinKindKey)) ? "Left" : node.Settings[JoinKindKey];
                    var cardinality = string.IsNullOrWhiteSpace(node.Settings.GetValueOrDefault(CardinalityKey)) ? "FanOut" : node.Settings[CardinalityKey];

                    <h3>Join inputs</h3>
                    <label class="field-label">Left source</label>
                    <select class="selector" value="@leftValue" @onchange="@(args => SetJoinSetting(node, LeftSourceKey, args.Value?.ToString()))">
                        <option value="@WorkingDocumentSelector">* (working document so far)</option>
                        @foreach (var parse in ParseNodes)
                        {
                            <option value="@parse.GraphId">@parse.GraphId</option>
                        }
                        @if (!string.Equals(leftValue, WorkingDocumentSelector, StringComparison.Ordinal) && FindParse(leftValue) is null)
                        {
                            <option value="@leftValue">@leftValue (unknown parse node)</option>
                        }
                    </select>
                    <HelpTooltip Label="Join sources">Sources are parse node ids. Choose "*" to join against everything accumulated so far when chaining joins.</HelpTooltip>

                    <label class="field-label">Right source *</label>
                    <select class="selector" value="@rightValue" @onchange="@(args => SetJoinSetting(node, RightSourceKey, args.Value?.ToString()))">
                        <option value="">(select a parse node)</option>
                        @foreach (var parse in ParseNodes)
                        {
                            <option value="@parse.GraphId">@parse.GraphId</option>
                        }
                        @if (!string.IsNullOrWhiteSpace(rightValue) && FindParse(rightValue) is null)
                        {
                            <option value="@rightValue">@rightValue (unknown parse node)</option>
                        }
                    </select>

                    <label class="field-label">Join kind</label>
                    <select class="selector" value="@joinKind" @onchange="@(args => SetJoinSetting(node, JoinKindKey, args.Value?.ToString()))">
                        @foreach (var option in JoinKindOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>

                    <label class="field-label">Result cardinality</label>
                    <select class="selector" value="@cardinality" @onchange="@(args => SetJoinSetting(node, CardinalityKey, args.Value?.ToString()))">
                        @foreach (var option in CardinalityOptions)
                        {
                            <option value="@option">@CardinalityLabel(option)</option>
                        }
                    </select>

                    @if (string.Equals(cardinality, "Nested", StringComparison.OrdinalIgnoreCase))
                    {
                        <label class="field-label">Nested target path *</label>
                        <ReferenceInput Value="@(node.Settings.GetValueOrDefault(NestedPathKey) ?? string.Empty)"
                                        Placeholder="order.lineItems" Label="Nested target path" References="_configReferences"
                                        ValueChanged="value => SetJoinSetting(node, NestedPathKey, value)" />
                        <HelpTooltip Label="Nested target">Where the array of mapped right rows is written on each left row, e.g. <code>order.lineItems</code>. Required for nested cardinality.</HelpTooltip>
                    }

                    <h3>Join keys</h3>
                    <HelpTooltip Label="Join keys">Every key pair must match for two rows to join. Paths use the payload path convention, e.g. <code>$.customerId</code> or <code>order.customer.id</code>.</HelpTooltip>
                    @if (joinEditor.Keys.Count == 0)
                    {
                        <p class="field-hint">No join keys yet. Add at least one pair.</p>
                    }
                    @foreach (var key in joinEditor.Keys)
                    {
                        <div class="inline-row" @key="key">
                            <ReferenceInput Placeholder="@($"Left path ({JoinSideName(node, "Left")})")" Value="@key.LeftPath"
                                            Label="Left join path" References="_configReferences" ValueChanged="value => SetJoinKeyPath(node, key, true, value)" />
                            <ReferenceInput Placeholder="@($"Right path ({JoinSideName(node, "Right")})")" Value="@key.RightPath"
                                            Label="Right join path" References="_configReferences" ValueChanged="value => SetJoinKeyPath(node, key, false, value)" />
                            <button class="secondary-button" @onclick="@(() => RemoveJoinKey(node, key))">Remove</button>
                        </div>
                    }
                    <div class="action-row">
                        <button class="secondary-button" @onclick="@(() => AddJoinKey(node))">Add join key</button>
                    </div>

                    <h3>Join field mappings</h3>
                    <HelpTooltip Label="Join field mappings">Each row writes one target field from the left row, the right row, a literal JSON value, or a transform (e.g. concatenate, add, format date) of several such inputs.</HelpTooltip>
                    <table class="mapping-table">
                        <thead>
                            <tr>
                                <th>Reads from</th>
                                <th>Source path</th>
                                <th>Target field</th>
                                <th>Condition</th>
                                <th>Literal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in joinEditor.Mappings)
                            {
                                var isTransformRow = string.Equals(row.SourceKind, "Transform", StringComparison.OrdinalIgnoreCase);
                                <tr @key="row">
                                    <td>
                                        <select class="selector compact" value="@row.SourceKind" @onchange="@(args => SetJoinMappingField(node, row, JoinMappingField.SourceKind, args.Value?.ToString()))">
                                            @foreach (var kind in SourceKindOptions)
                                            {
                                                <option value="@kind">@JoinSideLabel(node, row, kind)</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        @if (isTransformRow)
                                        {
                                            <span class="muted">(transform below)</span>
                                        }
                                        else
                                        {
                                            <ReferenceInput Value="@row.SourcePath" ValueChanged="value => SetJoinMappingField(node, row, JoinMappingField.SourcePath, value)" Label="Mapping source path" References="_configReferences" />
                                        }
                                    </td>
                                    <td><ReferenceInput Value="@row.TargetField" ValueChanged="value => SetJoinMappingField(node, row, JoinMappingField.TargetField, value)" Label="Mapping target field" References="_configReferences" /></td>
                                    <td>
                                        <select class="selector compact" value="@row.Condition" @onchange="@(args => SetJoinMappingField(node, row, JoinMappingField.Condition, args.Value?.ToString()))">
                                            @foreach (var condition in ConditionOptions)
                                            {
                                                <option value="@condition">@condition</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        @if (!isTransformRow)
                                        {
                                            <ReferenceInput Value="@row.LiteralValue" ValueChanged="value => SetJoinMappingField(node, row, JoinMappingField.LiteralValue, value)" Label="Mapping literal JSON" References="_configReferences" />
                                        }
                                    </td>
                                    <td><button class="secondary-button" @onclick="@(() => RemoveJoinMapping(node, row))">Remove</button></td>
                                </tr>
                                @if (isTransformRow)
                                {
                                    var transformModule = FindCatalogModule(row.TransformModule);
                                    <tr @key="(TransformEditor: row, 1)">
                                        <td colspan="6">
                                            <label class="field-label">Transform module *</label>
                                            <select class="selector" value="@(row.TransformModule ?? string.Empty)" @onchange="@(args => SetJoinMappingField(node, row, JoinMappingField.TransformModule, args.Value?.ToString()))">
                                                <option value="">(select a transform)</option>
                                                @foreach (var module in TransformModules)
                                                {
                                                    <option value="@module.Id">@module.DisplayName (@module.Id)</option>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(row.TransformModule) && transformModule is null)
                                                {
                                                    <option value="@row.TransformModule">@row.TransformModule (not in catalog)</option>
                                                }
                                            </select>
                                            @if (transformModule is not null)
                                            {
                                                <p class="module-description">@transformModule.Description</p>
                                            }

                                            <label class="field-label">Transform inputs (in order)</label>
                                            @if (row.TransformInputs.Count == 0)
                                            {
                                                <p class="field-hint">No inputs yet. Add the values this transform should combine.</p>
                                            }
                                            @foreach (var input in row.TransformInputs)
                                            {
                                                var isLiteralInput = string.Equals(input.SourceKind, "Literal", StringComparison.OrdinalIgnoreCase);
                                                <div class="inline-row" @key="input">
                                                    <select class="selector compact" value="@input.SourceKind" @onchange="@(args => SetTransformInputField(node, row, input, JoinMappingField.SourceKind, args.Value?.ToString()))">
                                                        @foreach (var kind in ScalarSourceKindOptions)
                                                        {
                                                            <option value="@kind">@JoinSideLabel(node, kind)</option>
                                                        }
                                                    </select>
                                                    @if (isLiteralInput)
                                                    {
                                                        <ReferenceInput Placeholder="Literal JSON value" Value="@input.LiteralValue" Label="Transform literal JSON" References="_configReferences"
                                                                        ValueChanged="value => SetTransformInputField(node, row, input, JoinMappingField.LiteralValue, value)" />
                                                    }
                                                    else
                                                    {
                                                        <ReferenceInput Placeholder="Source path" Value="@input.SourcePath" Label="Transform source path" References="_configReferences"
                                                                        ValueChanged="value => SetTransformInputField(node, row, input, JoinMappingField.SourcePath, value)" />
                                                    }
                                                    <button class="secondary-button" @onclick="@(() => RemoveTransformInput(node, row, input))">Remove</button>
                                                </div>
                                            }
                                            <div class="action-row">
                                                <button class="secondary-button" @onclick="@(() => AddTransformInput(node, row))">Add input</button>
                                            </div>

                                            @(RenderSettingsEditor(transformModule?.Settings, row.TransformSettings, (key, value) => SetTransformSetting(node, row, key, value)))
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <HelpTooltip Label="Literal JSON">Literal values are raw JSON, so text literals need quotes: <code>"enriched"</code>.</HelpTooltip>
                    <div class="action-row">
                        <button class="secondary-button" @onclick="@(() => AddJoinMapping(node))">Add mapping</button>
                    </div>
                }
                else if (node.Stage == NodeStage.Render && node.ModuleId == "xml-mapping-render")
                {
                    <HelpTooltip Label="XML mapping settings">Edit this node's saved XML field mappings and preview sample output in the Mapping workspace.</HelpTooltip>
                    <button class="secondary-button" @onclick="() => OpenMappingDesigner(node)">Edit XML mapping</button>
                }
                else if (IsParsedMappingNode(node))
                {
                    <button class="secondary-button" @onclick="() => OpenMappingDesigner(node)">Edit parsed-data mapping</button>
                }
                else if (node.ModuleId == "xml-rules-augment")
                {
                    <label class="field-label">Input source (blank means all payloads)</label>
                    <ReferenceInput Value="@node.Settings.GetValueOrDefault("sourceId", "")" ValueChanged="@(value => node.Settings["sourceId"] = value)" Label="Rule input source" References="_configReferences" />
                    @RenderSettingsEditor(catalogModule?.Settings.Where(setting => setting.Key is not ("sourceId" or "policyJson")).ToArray(), node.Settings)
                    <details @key="node">
                        <summary>Choose an imported policy / version for this node</summary>
                        @if (_bizTalkAnalysis is { RulePolicies.Count: > 0 })
                        {
                            <BizTalkRulePolicies Policies="_bizTalkAnalysis.RulePolicies" ReplaceExisting="true" OnAddPolicy="@(value => node.Settings["policyJson"] = value)" />
                        }
                        else
                        {
                            <p>Analyze rule exports in Import from BizTalk to make their policies available here. This node's saved rules remain available below without the original export.</p>
                        }
                    </details>
                    <XmlRulePolicyEditor @key="node.Id" PolicyJson="@node.Settings.GetValueOrDefault("policyJson", "")" PolicyJsonChanged="@(value => node.Settings["policyJson"] = value)" />
                }
                else if (node.ModuleId == "stateful-orchestration-augment")
                {
                    @RenderSettingsEditor(catalogModule?.Settings.Where(setting => setting.Key != "stateCaptureJson").ToArray(), node.Settings)
                    <OrchestrationStateEditor @key="node.Id" Settings="node.Settings" References="_configReferences" />
                }
                else if (node.ModuleId == "metadata-promotion-augment")
                {
                    @RenderSettingsEditor(catalogModule?.Settings.Where(setting => setting.Key is not ("promotionsJson" or "namespacesJson")).ToArray(), node.Settings)
                    <MetadataPromotionEditor @key="node.Id" Settings="node.Settings" References="_configReferences" />
                }
                else if (node.ModuleId == "odx-program-augment")
                {
                    <p>Native durable subset: supported filters and scoped receive/send correlations execute with explicit bindings. Original helpers, transaction scopes and full source translation remain incomplete. Private source JSON is editable below; this does not approve imported execution.</p>
                    @RenderSettingsEditor(catalogModule?.Settings.Where(setting => setting.Key is not ("casesJson" or "sendsJson")).ToArray(), node.Settings)
                    <RenderDispatchEditor @key="node.Id" Settings="node.Settings" Modules="_modules" References="_configReferences" OdxMode="true" />
                    <OdxSendEditor @key='(node.Id, "sends")' Settings="node.Settings" Modules="_modules" References="_configReferences" />
                }
                else if (IsNativeAugment(node))
                {
                    <p class="field-hint">Sequences, branches, loops and message operations are edited as visual steps, not nested property forms.</p>
                    <button class="run-button" @onclick="() => OpenAugmentDesigner(node)">Edit augment steps</button>
                }
                else if (node.ModuleId == "render-pipeline")
                {
                    <RenderPipelineEditor @key="node.Id" Value="@node.Settings.GetValueOrDefault("stagesJson", "[]")" ValueChanged='value => node.Settings["stagesJson"] = value' Modules="_modules" References="_configReferences" />
                }
                else if (node.ModuleId is "render-dispatch" or "map-dispatch-augment")
                {
                    @if (node.ModuleId == "map-dispatch-augment")
                    {
                        <p>The selected map replaces the working payload here. Later augments must accept its output format; this step does not deliver messages.</p>
                    }
                    <RenderDispatchEditor @key="node.Id" Settings="node.Settings" Modules="_modules" References="_configReferences" />
                }
                else
                {
                    @RenderSettingsEditor(catalogModule?.Settings, node.Settings)
                }

                var descriptorKeys = catalogModule?.Settings.Select(static setting => setting.Key).ToHashSet(StringComparer.OrdinalIgnoreCase)
                    ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                var extraKeys = node.Settings.Keys.Where(key => !descriptorKeys.Contains(key)
                    && !(IsNativeAugment(node) && key.Equals("flowJson", StringComparison.OrdinalIgnoreCase)))
                    .OrderBy(static key => key, StringComparer.OrdinalIgnoreCase).ToArray();

                @if (extraKeys.Length > 0)
                {
                    <h3>Additional settings</h3>
                    @foreach (var key in extraKeys)
                    {
                        <div class="setting-row" @key="key">
                            <label class="field-label">@key</label>
                            <div class="inline-row">
                                <ReferenceInput Value="@node.Settings[key]" ValueChanged="value => node.Settings[key] = value" Label="@key" References="_configReferences" />
                                <button class="secondary-button" @onclick="() => node.Settings.Remove(key)">Remove</button>
                            </div>
                        </div>
                    }
                }

                <details>
                    <summary>Advanced: add a module setting</summary>
                    <p class="field-hint">Only add a key documented by this module. This does not create variables, map fields, or new behavior.</p>
                    <div class="inline-row">
                        <input class="mapping-input" aria-label="Custom module setting key" @bind="_newSettingKey" @bind:event="oninput" placeholder="Setting key" />
                        <button class="secondary-button" @onclick="() => AddCustomSetting(node)">Add</button>
                    </div>
                </details>
                <details @key='(node.Id, "retry")'>
                    <summary>Step retry policy</summary>
                    <RetryPolicyEditor Policy="node.Retry" PolicyChanged="value => node.Retry = value" />
                </details>

                @if (node.Stage == NodeStage.Augment)
                {
                    <h3>Order</h3>
                    <HelpTooltip Label="Augment order">Augment steps run in order after every source has been fetched and parsed. Join behaviour is configured through the module's own settings.</HelpTooltip>
                    <div class="inline-row">
                        <button class="secondary-button" @onclick="() => MoveAugment(node, -1)">Move earlier</button>
                        <button class="secondary-button" @onclick="() => MoveAugment(node, 1)">Move later</button>
                    </div>
                }

                @if (node.Stage is NodeStage.Render or NodeStage.Deliver)
                {
                    var route = FindRoute(node.RouteId);
                    var deliverCount = route?.Delivers.Count ?? 0;
                    <h3>Delivery route</h3>
                    <HelpTooltip Label="Delivery route">Route @RouteNumber(node) renders once and hands the same output to its @deliverCount deliver node(s). Each deliver runs independently, unless the route has an atomic scope.</HelpTooltip>

                    @if (route?.Render is { } routeRender)
                    {
                        <label class="field-label">Atomic scope (optional)</label>
                        <input class="mapping-input" value="@routeRender.AtomicScope" placeholder="e.g. order-commit"
                               @onchange="@(args => { routeRender.AtomicScope = NormalizeAtomicScope(args.Value?.ToString()); })" />
                        <HelpTooltip Label="Atomic scope">If a delivery fails permanently, the host attempts configured compensation for earlier deliveries in this scope and skips remaining ones. Missing or failed compensation cannot undo a delivery. This is not a distributed transaction. Leave empty for independent delivery.</HelpTooltip>
                    }

                    @if (node.Stage == NodeStage.Deliver)
                    {
                        <label class="field-label"><input type="checkbox" @bind="node.RequireConfirmation" /> Require delivery confirmation</label>
                        <p class="field-hint">Requires a durable database and a confirmation-capable destination that atomically deduplicates this delivery ID. This does not guarantee downstream effects. @(FindCatalogModule(node.ModuleId)?.SupportsConfirmation == true ? "Module supports confirmation." : "Module does not currently advertise confirmation support.")</p>
                        <details @key='(node.Id, "compensation")'>
                            <summary>Delivery compensation</summary>
                            <p class="field-hint">Optional undo action for deliveries in a named atomic scope. This is best-effort compensation, not a distributed transaction. The compensation module must be safe to repeat.</p>
                            <label class="field-label">Compensation module
                                <select class="selector" value="@(node.Compensation?.Module ?? "")" @onchange="args => SetCompensationModule(node, args.Value?.ToString())">
                                    <option value="">None</option>
                                    @foreach (var module in ModulesForStage(NodeStage.Deliver)) { <option value="@module.Id">@module.DisplayName (@module.Id)</option> }
                                    @if (node.Compensation is { } missing && FindCatalogModule(missing.Module) is null) { <option value="@missing.Module">@missing.Module (not loaded)</option> }
                                </select>
                            </label>
                            @if (node.Compensation is { } compensation)
                            {
                                @RenderSettingsEditor(FindCatalogModule(compensation.Module)?.Settings, compensation.Settings)
                                @foreach (var key in compensation.Settings.Keys.Where(key => !(FindCatalogModule(compensation.Module)?.Settings.Any(setting => setting.Key.Equals(key, StringComparison.OrdinalIgnoreCase)) ?? false)).ToArray())
                                {
                                    <ReferenceInput Value="@compensation.Settings[key]" ValueChanged="value => compensation.Settings[key] = value" Label="@($"Compensation {key}")" References="_configReferences" />
                                }
                            }
                        </details>
                    }

                    @if (route?.Render is null)
                    {
                        <p class="field-hint">This route is missing its render. Restore it without removing the deliver nodes or their settings.</p>
                        <button class="secondary-button" @onclick="() => AddRenderToRoute(node.RouteId)">Add render to this route</button>
                    }
                    <div class="action-row">
                        <button class="secondary-button" @onclick="() => AddDeliverToRoute(node.RouteId)" title="Adds another deliver node that receives this route's rendered output.">Add deliver node</button>
                    </div>
                }

                <div class="action-row">
                    @if (node.Stage is NodeStage.Render or NodeStage.Deliver)
                    {
                        @if (node.Stage == NodeStage.Render)
                        {
                            <button class="secondary-button" @onclick="() => RemoveCanvasNode(node)">Remove render only</button>
                        }
                        @if (node.Stage == NodeStage.Deliver && (FindRoute(node.RouteId)?.Delivers.Count ?? 0) > 1)
                        {
                            <button class="secondary-button" @onclick="() => RemoveDeliverNode(node)" title="Removes only this deliver node; the route keeps its render node and other deliver nodes.">Remove deliver node</button>
                        }
                        <button class="secondary-button" @onclick="() => RemoveRoute(node.RouteId)">Remove route</button>
                    }
                    else if (node.Stage == NodeStage.Fetch)
                    {
                        <button class="secondary-button" @onclick="() => RemoveFetchNode(node)">Remove fetch node</button>
                    }
                    else if (node.Stage == NodeStage.Parse)
                    {
                        <button class="secondary-button" @onclick="() => RemoveParseNode(node, includeExclusiveFetches: false)" title="Removes only this parse node; its fetch nodes stay on the canvas, unlinked, so they can be re-linked.">Remove parse node</button>
                        <button class="secondary-button" @onclick="() => RemoveParseNode(node, includeExclusiveFetches: true)" title="Also removes the fetch nodes that no other parse node parses.">Remove source (with its fetches)</button>
                    }
                    else
                    {
                        <button class="secondary-button" @onclick="() => RemoveNode(node)">Remove node</button>
                    }
                </div>
            }
        </div>
    </aside>

    @if (_migration is not null || _bizTalkRequirements.Count > 0 || _bizTalkWarnings.Count > 0)
    {
        <FloatingPanel Title="BizTalk import follow-up" Icon="📋" X="420" Y="24" Width="520">
            <HelpTooltip Label="Import follow-up">Config, secret, and review items reported for the current draft. These reports do not approve execution.</HelpTooltip>

            @if (_migration is { } migration)
            {
                <MigrationReport Report="migration" />
            }
            @if (_bizTalkRequirements.Count > 0)
            {
                <table class="module-table">
                    <thead>
                        <tr>
                            <th>Kind</th>
                            <th>Setting</th>
                            <th>Reference</th>
                            <th>Applied</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var requirement in _bizTalkRequirements)
                        {
                            <tr>
                                <td>@requirement.Kind</td>
                                <td class="path-value">@requirement.SettingPath</td>
                                <td class="path-value">@requirement.ReferenceName</td>
                                <td>@(requirement.AppliedToDraft ? "Placeholder in draft" : "Recommendation only")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_bizTalkWarnings.Count > 0)
            {
                <div class="warning-panel">
                    <h3>Draft warnings</h3>
                    <ul>
                        @foreach (var warning in _bizTalkWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
        </FloatingPanel>
    }
        </div>
        <section id="mapping-workspace" class="mapping-workspace" role="tabpanel" aria-labelledby="mapping-workspace-tab" hidden="@(!_showMappingDesigner)">
            @if (_mappingDesignerOpened)
            {
                <div class="mapping-workspace-toolbar">
                    <h2>Mapping Designer</h2>
                    <HelpTooltip Label="Mapping workspace">Parsed-data maps run after parsing and before rendering. XML maps belong to XML render nodes. Both save with the flow. XSLT paths and join mappings remain in Flow Properties.</HelpTooltip>
                    @if (MappingNodes.Count > 0)
                    {
                        <label for="active-xml-map">Mapping step</label>
                        <select id="active-xml-map" class="selector" value="@ActiveMappingNodeId" @onchange="e => _selectedMappingNodeId = e.Value?.ToString()">
                            @foreach (var mapNode in MappingNodes)
                            {
                                <option value="@mapNode.Id">@NodeHeading(mapNode)</option>
                            }
                        </select>
                    }
                    <button class="secondary-button" @onclick="AddParsedDataMapping">Add parsed-data map</button>
                    <button class="secondary-button" @onclick="AddXmlMappingRender">Add XML mapping render</button>
                </div>
                @if (_migration is not null)
                {
                    <p class="status-banner error compact">@FlowMigrationReportViewModel.ExecutionBlockReason</p>
                }
                @if (MappingNodes.Count == 0)
                {
                    <p>Add a parsed-data map for any parser, or an XML mapping render for XML-to-XML mappings.</p>
                }
                @foreach (var mapNode in MappingNodes)
                {
                    <div @key="mapNode.Id" hidden="@(mapNode.Id != ActiveMappingNodeId)">
                        @if (IsParsedMappingNode(mapNode))
                        {
                            <ParsedDataMappingEditor Settings="mapNode.Settings" Sources="ParsedMappingSources" TransformModules="TransformModules" References="_configReferences" />
                        }
                        else
                        {
                            <XmlMappingEditor Value="@(mapNode.Settings.GetValueOrDefault("mappingJson") ?? string.Empty)" ValueChanged='value => mapNode.Settings["mappingJson"] = value' />
                        }
                    </div>
                }
                @foreach (var join in AugmentNodes.Where(IsJoinNode))
                {
                    <button class="secondary-button" @onclick="() => { SelectNode(join); SetMappingWorkspace(false); }">Edit field mappings for @NodeHeading(join)</button>
                }
            }
        </section>
        <section id="augment-workspace" class="augment-workspace" role="tabpanel" aria-labelledby="augment-workspace-tab" hidden="@(!_showAugmentDesigner)">
            @if (_augmentDesignerOpened)
            {
                <div class="mapping-workspace-toolbar">
                    <h2>Augment steps</h2>
                    <button type="button" class="secondary-button" @onclick="() => SetMappingWorkspace(false)">Back to flow</button>
                    @if (NativeAugmentNodes.Count > 0)
                    {
                        <label for="active-native-augment">Control-flow augment</label>
                        <select id="active-native-augment" class="selector" value="@ActiveNativeAugmentId" @onchange="e => _selectedAugmentNodeId = e.Value?.ToString()">
                            @foreach (var augment in NativeAugmentNodes)
                            {
                                <option value="@augment.Id">@NodeHeading(augment)</option>
                            }
                        </select>
                    }
                    <button type="button" class="secondary-button" @onclick="AddNativeAugment">Add control-flow augment</button>
                </div>
                @if (_migration is not null)
                {
                    <p class="status-banner error compact">@FlowMigrationReportViewModel.ExecutionBlockReason</p>
                }
                @if (NativeAugmentNodes.Count == 0)
                {
                    <p>Add a control-flow augment to build visual sequences, branches, loops and message operations. Other augment modules remain selectable nodes on the Flow canvas.</p>
                }
                @foreach (var augment in NativeAugmentNodes)
                {
                    <div @key="augment.Id" hidden="@(augment.Id != ActiveNativeAugmentId)">
                        <NativeFlowEditor Value='@(augment.Settings.GetValueOrDefault("flowJson", "{\"version\":1,\"nodes\":[]}"))'
                                          ValueChanged='value => augment.Settings["flowJson"] = value' Modules="_modules" References="_configReferences" ShowGraph="true" />
                    </div>
                }
            }
        </section>
    </div>

    <footer class="designer-save-bar">
        <p>Flow, augment and mapping changes are not saved automatically.</p>
        <button class="run-button designer-save-button" @onclick="SaveAsync" disabled="@(_isSaving || _isAnalyzingSample)">@(_isSaving ? "Saving..." : IsExistingFlow ? "Save flow" : "Create flow")</button>
    </footer>
</div>

