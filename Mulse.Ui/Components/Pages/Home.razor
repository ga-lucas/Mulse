@page "/"
@inject IMulseApiClient ApiClient

<PageTitle>Dashboard | Mulse</PageTitle>

<div class="page-shell">
    <header class="page-hero">
        <div>
            <p class="eyebrow">Workspace overview</p>
            <h1>Dashboard</h1>
            <p class="lede">Find and organize your integration flows, manage copies, and review configuration gaps. <a href="/modules">Manage runtime modules</a>.</p>
        </div>
        <a class="run-button" href="/designer">+ Create flow</a>
    </header>

    <StatusBanner Error="@_errorMessage" Success="@_lastRunMessage" />

    @if (_isLoading)
    {
        <p class="loading-state" role="status">Loading your workspace...</p>
    }
    else
    {
        <dl class="overview-grid" aria-label="Workspace summary">
            <div class="overview-stat"><dt>Configured flows</dt><dd>@_flows.Count</dd></div>
            <div class="overview-stat"><dt>Enabled flows</dt><dd>@_flows.Count(flow => flow.Enabled)</dd></div>
            <div class="overview-stat"><dt>Available modules</dt><dd>@_modules.Count</dd></div>
            <div class="overview-stat"><dt>Unresolved usages</dt><dd>@_configUsages.Count(usage => !usage.IsResolved)</dd></div>
        </dl>

        <section class="dashboard-grid">
            <Panel Title="Your flows" Description="Configure, enable, and run your integration pipelines.">
                <HeaderActions>
                    <a class="secondary-button" href="/backup-restore">Backup / restore / delete all</a>
                    <a class="run-button" href="/designer">New flow</a>
                </HeaderActions>
                <ChildContent>
                <div class="flow-filters">
                    <label>Search flows
                        <input type="search" @bind="_search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Flow name, ID, category, module, or source" />
                    </label>
                    <label>Category
                        <select @bind="_categoryFilter" @bind:after="ResetPage">
                            <option value="">All categories</option>
                            <option value="none">Uncategorized</option>
                            @foreach (var category in Categories)
                            {
                                <option value="@($"category:{category}")">@category</option>
                            }
                        </select>
                    </label>
                    <label>Status
                        <select @bind="_statusFilter" @bind:after="ResetPage">
                            <option value="">All statuses</option><option value="enabled">Enabled</option><option value="disabled">Disabled</option>
                        </select>
                    </label>
                    <label>Trigger
                        <select @bind="_triggerFilter" @bind:after="ResetPage">
                            <option value="">All triggers</option>
                            @foreach (var trigger in _flows.Select(flow => flow.TriggerMode).Distinct().Order())
                            {
                                <option value="@trigger">@trigger</option>
                            }
                        </select>
                    </label>
                    <label>Module
                        <select @bind="_moduleFilter" @bind:after="ResetPage">
                            <option value="">All modules</option>
                            @foreach (var module in _flows.SelectMany(FlowListFilter.Modules).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase))
                            {
                                <option value="@module">@module</option>
                            }
                        </select>
                    </label>
                    <label>Sort by flow ID
                        <select @bind="_descending" @bind:after="ResetPage"><option value="false">A to Z</option><option value="true">Z to A</option></select>
                    </label>
                    <label class="checkbox-label"><input type="checkbox" @bind="_unresolvedOnly" @bind:after="ResetPage" /> Unresolved configuration only</label>
                    <button class="secondary-button" @onclick="ClearFilters">Clear filters</button>
                </div>
                <p role="status">@FilteredFlows.Count of @_flows.Count flow(s) match</p>

                @if (_managedFlow is { } managed)
                {
                    <section class="flow-action-editor" @ref="_actionEditor" tabindex="-1" aria-labelledby="flow-action-title">
                        <h3 id="flow-action-title">@ActionTitle: @managed.Id</h3>
                        <form @onsubmit="SaveActionAsync" @onsubmit:preventDefault>
                            @if (_flowAction == "duplicate")
                            {
                                <label>New flow ID <input @bind="_newFlowId" required /></label>
                                <p>The copy starts disabled. Settings, category, and configuration references are copied; run history and pending retries are not.</p>
                            }
                            else if (_flowAction == "category")
                            {
                                <label>Category <input @bind="_newCategory" list="flow-categories" placeholder="Enter a category, or leave empty to clear" /></label>
                                <datalist id="flow-categories">
                                    @foreach (var category in Categories)
                                    {
                                        <option value="@category"></option>
                                    }
                                </datalist>
                            }
                            else
                            {
                                <p>Delete this flow permanently? Its saved definition, pending retries, and orchestration checkpoints will be removed. This does not undo deliveries or cancel a run already in progress.</p>
                            }
                            <div class="flow-card-actions">
                                <button type="submit" class="@(_flowAction == "delete" ? "secondary-button danger-button" : "run-button")" disabled="@IsBusy">@(_isManagingFlow ? "Saving..." : ActionTitle)</button>
                                <button type="button" class="secondary-button" @onclick="CancelAction" disabled="@IsBusy">Cancel</button>
                            </div>
                        </form>
                    </section>
                }

                @if (_flows.Count == 0)
                {
                    <div class="empty-state">
                        <h3>Your first integration starts here</h3>
                        <p>Create a flow from scratch, import sample data, or bring in a BizTalk solution.</p>
                        <a class="secondary-button" href="/designer">Open flow designer</a>
                    </div>
                }
                else if (FilteredFlows.Count == 0)
                {
                    <div class="empty-state"><h3>No matching flows</h3><p>Change your search or filters to find more flows.</p></div>
                }
                else
                {
                    <div class="flow-list">
                        @foreach (var flow in VisibleFlows)
                        {
                            <section class="flow-card" @key="flow.Id">
                                <div class="flow-card-header">
                                    <div>
                                        <div class="flow-title">
                                            <h3>@flow.DisplayName</h3>
                                            <span class="status-pill @(flow.Enabled ? "enabled" : null)">@(flow.Enabled ? "Enabled" : "Disabled")</span>
                                            <span class="status-pill">@(flow.Category ?? "Uncategorized")</span>
                                        </div>
                                        <p><strong>Flow ID:</strong> @flow.Id</p>
                                        <details>
                                        <summary>@flow.Parses.Count parse node(s) fed by @flow.Fetches.Count fetch node(s)</summary>
                                        <ul class="source-list">
                                            @foreach (var parse in flow.Parses)
                                            {
                                                var parseFetches = parse.FetchNodeIds
                                                    .Select(fetchId => flow.Fetches.FirstOrDefault(fetch => string.Equals(fetch.Id, fetchId, StringComparison.OrdinalIgnoreCase)))
                                                    .OfType<FlowFetchNodeViewModel>()
                                                    .ToArray();
                                                var parseInputs = parseFetches.SelectMany(static fetch => fetch.InputParseIds).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
                                                <li>
                                                    <strong>@parse.Id</strong>: @string.Join(" + ", parseFetches.Select(static fetch => $"{fetch.Fetch.Module} ({fetch.Id})")) &rarr; @parse.Parse.Module
                                                    @if (parseFetches.Length > 1)
                                                    {
                                                        <span class="source-inputs">(combines @parseFetches.Length fetches)</span>
                                                    }
                                                    @if (parseInputs.Length > 0)
                                                    {
                                                        <span class="source-inputs">(input from @string.Join(", ", parseInputs))</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                        </details>
                                    </div>
                                    <div class="flow-card-actions">
                                        <a class="secondary-button" href="@($"/designer/{Uri.EscapeDataString(flow.Id)}")">Configure</a>
                                        <button class="secondary-button" @onclick='() => BeginAction(flow, "category")' disabled="@IsBusy">Categorize</button>
                                        <button class="secondary-button" @onclick='() => BeginAction(flow, "duplicate")' disabled="@IsBusy">Duplicate</button>
                                        <button class="secondary-button danger-button" @onclick='() => BeginAction(flow, "delete")' disabled="@IsBusy">Delete</button>
                                        <button class="secondary-button" @onclick="() => ToggleFlowEnabledAsync(flow)" disabled="@(IsBusy || (!flow.Enabled && (HasUnresolvedConfig(flow.Id) || flow.MissingModules is { Count: > 0 })))" title="@((!flow.Enabled && (HasUnresolvedConfig(flow.Id) || flow.MissingModules is { Count: > 0 })) ? "Resolve missing modules and config/secret references before enabling this flow" : null)">
                                            @(flow.Enabled ? "Disable" : "Enable")
                                        </button>
                                        <button class="run-button" @onclick="() => RunFlowAsync(flow.Id)" disabled="@(IsBusy || HasUnresolvedConfig(flow.Id) || flow.MissingModules is { Count: > 0 })" title="@((HasUnresolvedConfig(flow.Id) || flow.MissingModules is { Count: > 0 }) ? "Resolve missing modules and config/secret references before running this flow" : null)">
                                            Run flow
                                        </button>
                                    </div>
                                </div>
                                @if (flow.MissingModules is { Count: > 0 } missingModules)
                                {
                                    <StatusBanner Compact="true">
                                        <ErrorContent>
                                            Unknown or unloaded modules: @string.Join(", ", missingModules).
                                            <a href="/module-packages">Load the required packages</a> or correct module references before enabling or running this flow.
                                        </ErrorContent>
                                    </StatusBanner>
                                }
                                @{ var unresolvedCount = CountUnresolvedConfig(flow.Id); }
                                @if (unresolvedCount > 0)
                                {
                                    <StatusBanner Compact="true">
                                        <ErrorContent>
                                            @unresolvedCount unresolved config/secret reference(s). <a href="/config-values">Resolve on the Config values page</a> before enabling or running this flow.
                                        </ErrorContent>
                                    </StatusBanner>
                                }
                                <dl class="flow-metadata">
                                    <div>
                                        <dt>Enabled</dt>
                                        <dd>@(flow.Enabled ? "Yes" : "No")</dd>
                                    </div>
                                    <div>
                                        <dt>Trigger</dt>
                                        <dd>@flow.TriggerMode</dd>
                                    </div>
                                    <div>
                                        <dt>Interval</dt>
                                        <dd>@(flow.Interval?.ToString() ?? "n/a")</dd>
                                    </div>
                                    <div>
                                        <dt>Deliveries</dt>
                                        <dd>@(flow.Deliveries.Count == 0 ? "None" : flow.Deliveries.Count.ToString())</dd>
                                    </div>
                                </dl>
                                <p><strong>Augments:</strong> @FormatModules(flow.AugmentModules)</p>
                                <p><strong>Renders:</strong> @FormatModules(flow.RenderModules)</p>
                                <p><strong>Delivers:</strong> @FormatModules(flow.DeliverModules)</p>
                            </section>
                        }
                    </div>
                    <nav class="flow-pagination" aria-label="Flow list pages">
                        <button class="secondary-button" @onclick="PreviousPage" disabled="@(CurrentPage == 1)">Previous</button>
                        <span>Page @CurrentPage of @PageCount</span>
                        <button class="secondary-button" @onclick="NextPage" disabled="@(CurrentPage == PageCount)">Next</button>
                    </nav>
                }
                </ChildContent>
            </Panel>

        </section>
    }
</div>

@code {
    private IReadOnlyList<FlowViewModel> _flows = [];
    private IReadOnlyList<ModuleViewModel> _modules = [];
    private IReadOnlyList<ConfigReferenceUsageViewModel> _configUsages = [];
    private bool _isLoading = true;
    private bool _isRunningFlow;
    private bool _isTogglingFlowEnabled;
    private bool _isManagingFlow;
    private string? _errorMessage;
    private string? _lastRunMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            _flows = await ApiClient.GetFlowsAsync(CancellationToken.None);
            _modules = await ApiClient.GetModulesAsync(CancellationToken.None);
            _configUsages = await ApiClient.GetConfigValueUsagesAsync(CancellationToken.None);
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to load orchestration metadata: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunFlowAsync(string flowId)
    {
        _isRunningFlow = true;
        _errorMessage = null;
        _lastRunMessage = null;

        try
        {
            var result = await ApiClient.RunFlowAsync(flowId, CancellationToken.None);
            _lastRunMessage = $"Ran {result.FlowId} with {result.PayloadCount} payload(s) across {result.DeliverModules.Count} deliver action(s).";
            if (!string.IsNullOrWhiteSpace(result.Detail))
            {
                _lastRunMessage += $" {result.Detail}";
            }
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to run flow '{flowId}': {exception.Message}";
        }
        finally
        {
            _isRunningFlow = false;
            await LoadAsync();
        }
    }

    private async Task ToggleFlowEnabledAsync(FlowViewModel flow)
    {
        _isTogglingFlowEnabled = true;
        _errorMessage = null;
        _lastRunMessage = null;

        try
        {
            var updated = await ApiClient.SetFlowEnabledAsync(flow.Id, !flow.Enabled, CancellationToken.None);
            _lastRunMessage = $"Flow '{updated.Id}' is now {(updated.Enabled ? "enabled" : "disabled")}.";
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to update flow '{flow.Id}': {exception.Message}";
        }
        finally
        {
            _isTogglingFlowEnabled = false;
            await LoadAsync();
        }
    }

    private static string FormatModules(IReadOnlyList<string> modules)
    {
        return modules.Count == 0 ? "None" : string.Join(", ", modules);
    }

    private int CountUnresolvedConfig(string flowId)
        => _configUsages.Count(usage => !usage.IsResolved && string.Equals(usage.FlowId, flowId, StringComparison.OrdinalIgnoreCase));

    private bool HasUnresolvedConfig(string flowId) => CountUnresolvedConfig(flowId) > 0;
}
