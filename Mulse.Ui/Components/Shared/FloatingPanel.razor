@* A lightweight floating, draggable, collapsible "tool window" used to host designer surface panels
   (toolbox, properties, overview, import dialogs) so they can float over a full-screen canvas instead
   of consuming fixed layout columns. Drag by the header; collapse to a title bar; optionally closable. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_panelElement" class="floating-panel @(IsCollapsed ? "collapsed" : null) @Class" style="--panel-x:@InitialX; --panel-y:@(F(_y))px; @(Width is { } w ? $"--panel-width:{F(w)}px; width:{F(w)}px;" : null)">
    <div @ref="_headerElement" class="floating-panel-header">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="floating-panel-icon" aria-hidden="true">@Icon</span>
        }
        <span class="floating-panel-title">@Title</span>
        <div class="floating-panel-header-actions">
            @HeaderActions
            <button type="button" class="floating-panel-btn" title="@(IsCollapsed ? "Expand" : "Collapse")" aria-label="@($"{(IsCollapsed ? "Expand" : "Collapse")} {Title}")" aria-expanded="@(!IsCollapsed ? "true" : "false")" @onclick="ToggleCollapsedAsync">@(IsCollapsed ? "▢" : "—")</button>
            @if (ShowClose)
            {
                <button type="button" class="floating-panel-btn" title="Close" aria-label="@($"Close {Title}")" @onclick="HandleCloseAsync">×</button>
            }
        </div>
    </div>
    @if (!IsCollapsed)
    {
        <div class="floating-panel-body">
            @ChildContent
        </div>
    }
</div>

@code {
    /// <summary>Title shown in the panel's header.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Optional single-glyph icon shown before the title.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Initial horizontal position, in pixels, relative to the nearest positioned ancestor.</summary>
    [Parameter]
    public double X { get; set; }

    /// <summary>Initially align to the right edge of the positioned ancestor until dragged.</summary>
    [Parameter]
    public bool AlignRight { get; set; }

    /// <summary>Initial vertical position, in pixels, relative to the nearest positioned ancestor.</summary>
    [Parameter]
    public double Y { get; set; }

    /// <summary>Optional fixed width, in pixels. Left unset, the panel sizes to its content.</summary>
    [Parameter]
    public double? Width { get; set; }

    /// <summary>Whether the panel is currently collapsed to just its header.</summary>
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback<bool> IsCollapsedChanged { get; set; }

    /// <summary>Shows a close ("×") button in the header when true.</summary>
    [Parameter]
    public bool ShowClose { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Extra CSS class(es) applied to the panel's root element.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Extra controls rendered in the header, before the collapse/close buttons (e.g. zoom controls).</summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private ElementReference _panelElement;
    private ElementReference _headerElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<FloatingPanel>? _selfReference;
    private bool _initialized;
    private bool _hasMoved;
    private double _x;
    private double _y;

    private string InitialX => AlignRight && !_hasMoved
        ? "calc(100% - var(--panel-width, 360px) - 1rem)"
        : $"{F(_x)}px";

    protected override void OnInitialized()
    {
        _x = X;
        _y = Y;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initialized || IsCollapsed)
        {
            return;
        }

        _initialized = true;
        _selfReference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/floating-panel.js");
        await _module.InvokeVoidAsync("initialize", _panelElement, _headerElement, _selfReference);
    }

    [JSInvokable]
    public void OnMoved(double x, double y)
    {
        _hasMoved = true;
        _x = x;
        _y = y;
        StateHasChanged();
    }

    private async Task ToggleCollapsedAsync()
    {
        IsCollapsed = !IsCollapsed;
        if (IsCollapsedChanged.HasDelegate)
        {
            await IsCollapsedChanged.InvokeAsync(IsCollapsed);
        }
    }

    private async Task HandleCloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private static string F(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _panelElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone, so there is nothing left to clean up on the client.
            }
        }

        _selfReference?.Dispose();
    }
}
