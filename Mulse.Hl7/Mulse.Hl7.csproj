<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net11.0;net10.0</TargetFrameworks>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<!-- Hot-loadable module package: Service does not project-reference this assembly. Instead it builds
		 directly into Service's plugins directory, where ModuleCatalog auto-discovers and loads it into a
		 collectible AssemblyLoadContext at runtime (see Service/Modules/ModuleCatalog.cs), matching the
		 same convention used by Mulse.SamplePlugin. This is what makes it reloadable/unloadable without
		 restarting the host. -->
	<OutDir Condition="'$(TargetFramework)' == 'net10.0'">..\Service\plugins\Mulse.Hl7\</OutDir>
	<OutDir Condition="'$(TargetFramework)' == 'net11.0'">..\Service\plugins\Mulse.Hl7\net11.0\</OutDir>
	<!-- See Mulse.Dbms.SqlServer.csproj: forces this plugin's own NuGet dependencies (if any are added later)
	     to be copied locally so the plugins/ folder stays self-contained. -->
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\Mulse.Modules\Mulse.Modules.csproj" />
  </ItemGroup>

</Project>
