<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Mulse.CompatibilityPack.Mapping" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Service\Service.csproj" />
    <ProjectReference Include="..\Mulse.Ui\Mulse.Ui.csproj" />
    <ProjectReference Include="..\Mulse.Excel\Mulse.Excel.csproj" />
    <ProjectReference Include="..\Mulse.SamplePlugin\Mulse.SamplePlugin.csproj" />
    <ProjectReference Include="..\Mulse.Billing\Mulse.Billing.csproj" />
    <ProjectReference Include="..\Mulse.Hl7\Mulse.Hl7.csproj" />
  </ItemGroup>

  <Target Name="BuildPluginCompatibilityFixtures" BeforeTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PluginCompatibilityFramework Include="net8.0;net9.0;net10.0" />
    </ItemGroup>
    <MSBuild Projects="..\Mulse.SamplePlugin\Mulse.SamplePlugin.csproj" Targets="Restore"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier"
             Properties="Configuration=$(Configuration);BuildingInsideVisualStudio=false;BuildProjectReferences=true" />
    <MSBuild Projects="..\Mulse.SamplePlugin\Mulse.SamplePlugin.csproj" Targets="Build"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier"
             Properties="Configuration=$(Configuration);TargetFramework=%(_PluginCompatibilityFramework.Identity);BuildingInsideVisualStudio=false;BuildProjectReferences=true" />
  </Target>

  <Target Name="CopyPluginCompatibilityFixtures" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PluginCompatibilityFile Include="..\Service\plugins\Mulse.SamplePlugin\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginCompatibilityFile)"
          DestinationFiles="@(_PluginCompatibilityFile->'$(OutDir)plugin-fixtures\Mulse.SamplePlugin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>