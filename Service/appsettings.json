{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Mulse": {
    "RuntimeStatePath": "Data\\mulse-runtime.json",
    "PluginDirectories": [
      "plugins"
    ],
    "Pipelines": [
      {
        "Id": "sample-file-pipeline",
        "Enabled": true,
        "Trigger": {
          "Mode": "OnDemand",
          "Interval": "00:05:00",
          "RunOnStartup": false
        },
        "Fetch": {
          "Module": "file-system-fetch",
          "Settings": {
            "path": "SampleData\\Inbox",
            "searchPattern": "*.json",
            "recursive": "false"
          }
        },
        "Parse": {
          "Module": "json-parse",
          "Settings": {}
        },
        "Augments": [
          {
            "Module": "json-envelope-augment",
            "Settings": {
              "scenario": "demo",
              "owner": "mulse"
            }
          }
        ],
        "Deliveries": [
          {
            "Render": {
              "Module": "json-render",
              "Settings": {
                "indented": "true"
              }
            },
            "Deliver": {
              "Module": "logging-deliver",
              "Settings": {
                "previewLength": "400"
              }
            }
          },
          {
            "Render": {
              "Module": "json-render",
              "Settings": {}
            },
            "Deliver": {
              "Module": "file-system-deliver",
              "Settings": {
                "path": "SampleData\\Outbox",
                "extension": ".json"
              }
            }
          }
        ]
      }
    ]
  }
}
