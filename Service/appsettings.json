{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Mulse": {
    "RuntimeStatePath": "Data\\mulse-runtime.json",
    "PluginDirectories": [
      "plugins"
    ],
    "Pipelines": [
      {
        "Id": "sample-file-pipeline",
        "Enabled": true,
        "Trigger": {
          "Mode": "OnDemand",
          "Interval": "00:05:00",
          "RunOnStartup": false
        },
        "Input": {
          "Module": "file-system",
          "Settings": {
            "path": "SampleData\\Inbox",
            "searchPattern": "*.json",
            "recursive": "false"
          }
        },
        "Augments": [
          {
            "Module": "json-envelope-augment",
            "Settings": {
              "scenario": "demo",
              "owner": "mulse"
            }
          }
        ],
        "Outputs": [
          {
            "Module": "logging-event",
            "Settings": {
              "previewLength": "400"
            }
          },
          {
            "Module": "file-system-storage",
            "Settings": {
              "path": "SampleData\\Outbox",
              "extension": ".json"
            }
          }
        ]
      }
    ]
  }
}
