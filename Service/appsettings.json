{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Mulse": {
    "RuntimeStatePath": "Data\\mulse-runtime.json",
    "PluginDirectories": [
      "plugins"
    ],
    "Pipelines": [
      {
        "Id": "sample-file-pipeline",
        "Enabled": true,
        "Trigger": {
          "Mode": "OnDemand",
          "Interval": "00:05:00",
          "RunOnStartup": false
        },
        "Sources": [
          {
            "Id": "primary",
            "Fetch": {
              "Module": "file-system-fetch",
              "Settings": {
                "path": "SampleData\\Inbox",
                "searchPattern": "*.json",
                "recursive": "false"
              }
            },
            "Parse": {
              "Module": "json-parse",
              "Settings": {}
            },
            "InputSourceIds": []
          }
        ],
        "Augments": [
          {
            "Module": "json-envelope-augment",
            "Settings": {
              "scenario": "demo",
              "owner": "mulse"
            }
          }
        ],
        "Deliveries": [
          {
            "Render": {
              "Module": "json-render",
              "Settings": {
                "indented": "true"
              }
            },
            "Deliver": {
              "Module": "logging-deliver",
              "Settings": {
                "previewLength": "400"
              }
            }
          },
          {
            "Render": {
              "Module": "json-render",
              "Settings": {}
            },
            "Deliver": {
              "Module": "file-system-deliver",
              "Settings": {
                "path": "SampleData\\Outbox",
                "extension": ".json"
              }
            }
          }
        ]
      },
      {
        "Id": "sample-multi-source-join-pipeline",
        "Enabled": true,
        "Trigger": {
          "Mode": "OnDemand",
          "RunOnStartup": false
        },
        "Sources": [
          {
            "Id": "orders",
            "Fetch": {
              "Module": "file-system-fetch",
              "Settings": {
                "path": "SampleData\\Inbox",
                "searchPattern": "*.json",
                "recursive": "false"
              }
            },
            "Parse": {
              "Module": "json-parse",
              "Settings": {}
            },
            "InputSourceIds": []
          },
          {
            "Id": "customers",
            "Fetch": {
              "Module": "file-system-fetch",
              "Settings": {
                "path": "SampleData\\Reference",
                "searchPattern": "customers.json",
                "recursive": "false"
              }
            },
            "Parse": {
              "Module": "json-parse",
              "Settings": {}
            },
            "InputSourceIds": [
              "orders"
            ]
          }
        ],
        "Augments": [
          {
            "Module": "multi-source-join-map-augment",
            "Settings": {
              "leftSourceId": "orders",
              "rightSourceId": "customers",
              "joinKeysJson": "[{\"leftPath\":\"$.customer\",\"rightPath\":\"$.customerName\"}]",
              "joinKind": "Left",
              "resultCardinality": "FanOut",
              "mappingJson": "[{\"sourceKind\":\"Left\",\"sourcePath\":\"$.orderId\",\"targetField\":\"order.id\",\"condition\":\"Always\"},{\"sourceKind\":\"Left\",\"sourcePath\":\"$.customer\",\"targetField\":\"order.customerName\",\"condition\":\"Always\"},{\"sourceKind\":\"Left\",\"sourcePath\":\"$.priority\",\"targetField\":\"order.priority\",\"condition\":\"Always\"},{\"sourceKind\":\"Left\",\"sourcePath\":\"$.items\",\"targetField\":\"order.items\",\"condition\":\"Always\"},{\"sourceKind\":\"Right\",\"sourcePath\":\"$.customerId\",\"targetField\":\"customer.id\",\"condition\":\"WhenMatched\"},{\"sourceKind\":\"Right\",\"sourcePath\":\"$.tier\",\"targetField\":\"customer.tier\",\"condition\":\"WhenMatched\"},{\"sourceKind\":\"Right\",\"sourcePath\":\"$.accountManager\",\"targetField\":\"customer.accountManager\",\"condition\":\"WhenMatched\"},{\"sourceKind\":\"Literal\",\"literalValue\":\"\\\"enriched\\\"\",\"targetField\":\"customer.status\",\"condition\":\"WhenMatched\"},{\"sourceKind\":\"Literal\",\"literalValue\":\"\\\"unknown-customer\\\"\",\"targetField\":\"customer.status\",\"condition\":\"WhenUnmatched\"}]"
            }
          }
        ],
        "Deliveries": [
          {
            "Render": {
              "Module": "json-render",
              "Settings": {
                "indented": "true"
              }
            },
            "Deliver": {
              "Module": "logging-deliver",
              "Settings": {
                "previewLength": "800"
              }
            }
          },
          {
            "Render": {
              "Module": "json-render",
              "Settings": {
                "indented": "true"
              }
            },
            "Deliver": {
              "Module": "file-system-deliver",
              "Settings": {
                "path": "SampleData\\Outbox",
                "extension": ".json"
              }
            }
          }
        ]
      },
      {
        "Id": "sample-sql-lookup-join-pipeline",
        "Enabled": false,
        "Trigger": {
          "Mode": "OnDemand",
          "RunOnStartup": false
        },
        "Sources": [
          {
            "Id": "primary",
            "Fetch": {
              "Module": "file-system-fetch",
              "Settings": {
                "path": "SampleData\\Inbox",
                "searchPattern": "*.json",
                "recursive": "false"
              }
            },
            "Parse": {
              "Module": "json-parse",
              "Settings": {}
            },
            "InputSourceIds": []
          },
          {
            "Id": "sqlContracts",
            "Fetch": {
              "Module": "sql-server-lookup-fetch",
              "Settings": {
                "connectionString": "Server=tcp:sql.example.test,1433;Database=Orders;User ID=integration-user;Password=replace-me;TrustServerCertificate=True",
                "idPaths": "$.customer",
                "queryText": "select value as CustomerName, concat('CON-', value) as ContractId, concat(value, ' master agreement') as ContractName from string_split(@ids, ',')",
                "idsParameterName": "@ids"
              }
            },
            "Parse": {
              "Module": "json-parse",
              "Settings": {}
            },
            "InputSourceIds": [
              "primary"
            ]
          }
        ],
        "Augments": [
          {
            "Module": "multi-source-join-map-augment",
            "Settings": {
              "leftSourceId": "primary",
              "rightSourceId": "sqlContracts",
              "joinKeysJson": "[{\"leftPath\":\"$.customer\",\"rightPath\":\"$.CustomerName\"}]",
              "joinKind": "Left",
              "resultCardinality": "Nested",
              "nestedTargetPath": "order.contracts",
              "mappingJson": "[{\"sourceKind\":\"Left\",\"sourcePath\":\"$.orderId\",\"targetField\":\"order.id\",\"condition\":\"Always\"},{\"sourceKind\":\"Left\",\"sourcePath\":\"$.customer\",\"targetField\":\"order.customerName\",\"condition\":\"Always\"},{\"sourceKind\":\"Right\",\"sourcePath\":\"$.ContractId\",\"targetField\":\"contractId\",\"condition\":\"Always\"},{\"sourceKind\":\"Right\",\"sourcePath\":\"$.ContractName\",\"targetField\":\"contractName\",\"condition\":\"Always\"}]"
            }
          }
        ],
        "Deliveries": [
          {
            "Render": {
              "Module": "json-render",
              "Settings": {
                "indented": "true"
              }
            },
            "Deliver": {
              "Module": "logging-deliver",
              "Settings": {
                "previewLength": "800"
              }
            }
          }
        ]
      }
    ]
  }
}
