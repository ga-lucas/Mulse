<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Microsoft.Data.SqlClient (Mulse.Dbms.SqlServer) requires ICU globalization data for
         connection encryption negotiation; invariant mode is incompatible with it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>dotnet-Service-eb4daf54-1acc-46ea-a1e3-323c25c4136b</UserSecretsId>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mulse.ServiceDefaults\Mulse.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Mulse.Modules\Mulse.Modules.csproj" />
    <ProjectReference Include="..\Mulse.CompatibilityPack\Mulse.CompatibilityPack.csproj" />
    <ProjectReference Include="..\Mulse.Hl7\Mulse.Hl7.csproj" />
    <ProjectReference Include="..\Mulse.Dbms.SqlServer\Mulse.Dbms.SqlServer.csproj" />
  </ItemGroup>
</Project>
