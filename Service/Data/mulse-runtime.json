{
  "pluginDirectories": [
    "plugins"
  ],
  "managedPackages": [],
  "pipelines": [
    {
      "id": "sample-file-pipeline",
      "enabled": true,
      "trigger": {
        "mode": "OnDemand",
        "interval": "00:05:00",
        "runOnStartup": false
      },
      "fetch": {
        "module": "file-system-fetch",
        "settings": {
          "path": "SampleData\\Inbox",
          "searchPattern": "*.json",
          "recursive": "false"
        }
      },
      "parse": {
        "module": "json-parse",
        "settings": {}
      },
      "augments": [
        {
          "module": "json-envelope-augment",
          "settings": {
            "scenario": "demo",
            "owner": "mulse"
          }
        }
      ],
      "deliveries": [
        {
          "render": {
            "module": "json-render",
            "settings": {
              "indented": "true"
            }
          },
          "deliver": {
            "module": "logging-deliver",
            "settings": {
              "previewLength": "400"
            }
          }
        },
        {
          "render": {
            "module": "json-render",
            "settings": {}
          },
          "deliver": {
            "module": "file-system-deliver",
            "settings": {
              "path": "SampleData\\Outbox",
              "extension": ".json"
            }
          }
        }
      ]
    }
  ],
  "orchestrationCheckpoints": []
}