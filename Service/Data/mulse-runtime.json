{
  "pluginDirectories": [
    "plugins"
  ],
  "managedPackages": [],
  "pipelines": [
    {
      "id": "sample-file-pipeline",
      "enabled": true,
      "trigger": {
        "mode": "OnDemand",
        "interval": "00:05:00",
        "runOnStartup": false
      },
      "fetch": {
        "module": "file-system-fetch",
        "settings": {
          "path": "SampleData\\Inbox",
          "searchPattern": "*.json",
          "recursive": "false"
        },
        "retry": null
      },
      "parse": {
        "module": "json-parse",
        "settings": {},
        "retry": null
      },
      "augments": [
        {
          "module": "json-envelope-augment",
          "settings": {
            "scenario": "demo",
            "owner": "mulse"
          },
          "retry": null
        }
      ],
      "deliveries": [
        {
          "render": {
            "module": "json-render",
            "settings": {
              "indented": "true"
            },
            "retry": null
          },
          "deliver": {
            "module": "logging-deliver",
            "settings": {
              "previewLength": "400"
            },
            "retry": null
          },
          "atomicScope": null,
          "compensation": null
        },
        {
          "render": {
            "module": "json-render",
            "settings": {},
            "retry": null
          },
          "deliver": {
            "module": "file-system-deliver",
            "settings": {
              "path": "SampleData\\Outbox",
              "extension": ".json"
            },
            "retry": null
          },
          "atomicScope": null,
          "compensation": null
        }
      ],
      "retry": null
    }
  ],
  "orchestrationCheckpoints": [],
  "pendingRetries": [],
  "configValues": {}
}